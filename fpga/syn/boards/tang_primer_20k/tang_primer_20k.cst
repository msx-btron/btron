// Physical Constraints for Sipeed Tang Primer 20K (GW2A-LV18PG256C8/I7)

IO_LOC "clk_27mhz" H11;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "key_reset_n" T10;
IO_PORT "key_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs (Active Low)
IO_LOC "led[0]" C13;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" A13;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" N16;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" N14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[4]" L14;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[5]" L16;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Audio
IO_LOC "audio_l" B11;
IO_PORT "audio_l" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "audio_r" B12;
IO_PORT "audio_r" IO_TYPE=LVCMOS33 DRIVE=8;

// HDMI / DVI
IO_LOC "tmds_d_p[0]" H14; // D0+
IO_LOC "tmds_d_n[0]" H16; // D0-
IO_LOC "tmds_d_p[1]" J15; // D1+
IO_LOC "tmds_d_n[1]" K16; // D1-
IO_LOC "tmds_d_p[2]" K14; // D2+
IO_LOC "tmds_d_n[2]" K15; // D2-
IO_LOC "tmds_d_p[3]" G16; // CLK+
IO_LOC "tmds_d_n[3]" H15; // CLK-

