\ @ID 06
\ @TITLE COBALT EUCLID
\ @SUBTITLE 10.17.47 · DIATONIC EUCLIDIAN GROOVE
\ @CATEGORY MATH-SYNTH
\ @PARTS 4
\ @PART 1 Kick + Bass
\ @PART 2 + Clap + Hats
\ @PART 3 + Diatonic Arp
\ @PART 4 + Harmony Third
\ @SPEED 2.0
\ @FORMULA bass=h(R+v)/12-2, arp=h(T)/12-1, h(d)=floor((12d+2)/7)

VARIABLE CE-J  VARIABLE CE-B  VARIABLE CE-N  VARIABLE CE-K  VARIABLE CE-F  VARIABLE CE-Q  VARIABLE CE-R  VARIABLE CE-T
VARIABLE CE-KICK  VARIABLE CE-BASS  VARIABLE CE-CLAP  VARIABLE CE-HAT  VARIABLE CE-ARP  VARIABLE CE-HARM

: CE-H ( d -- semi_f16 )
  DUP DIAT SWAP 7 IMOD 6 = CE-Q @ 3 = AND IF 1 + THEN F16 ;

: TRACK-EVAL ( x part -- )
  SWAP DUP FLOOR >INT CE-J !
  DUP FRAC CE-B !
  DUP 4.0 * DUP FRAC CE-F ! FLOOR >INT 32 + DUP CE-N ! 16 IMOD CE-K !
  DUP 8.0 + 4.0 / FLOOR >INT 0 3 CLAMP CE-Q !
  534 3 CE-Q @ - DIGIT CE-R !

  CE-B @ 0.333 < IF -20.0 CE-B @ * EXP 2.5 * 2.0 - ELSE QUIET THEN CE-KICK !
  44718 CE-K @ BIT CE-F @ 0.8 < AND IF
    CE-R @ CE-N @ 4 IMOD 1 = IF 4 + THEN CE-N @ 4 IMOD 3 = IF 7 + THEN
    CE-H 12.0 / 2.0 -
  ELSE QUIET THEN CE-BASS !
  CE-J @ 2 IMOD 1 = CE-B @ 0.1 < AND IF 2.3 6.0 CE-B @ * - ELSE QUIET THEN CE-CLAP !
  CE-F @ 0.20 < IF 2.4 2.5 CE-F @ * - ELSE QUIET THEN CE-HAT !
  7 CE-R @ + CE-N @ 8 IMOD 2 IMOD 3 I* + CE-T !
  CE-T @ CE-H 12.0 / 1.0 - CE-ARP !
  CE-T @ 2 - CE-H 12.0 / 1.0 - CE-HARM !
  DROP

  CASE
    0 OF 2 VOICES-N! CE-KICK @ 0 PRIM-SINE  CE-BASS @ 1 PRIM-TRI ENDOF
    1 OF 4 VOICES-N! CE-KICK @ 0 PRIM-SINE  CE-BASS @ 1 PRIM-TRI  CE-CLAP @ 2 PRIM-NSE  CE-HAT @ 3 SHIM-HIHAT ENDOF
    2 OF 5 VOICES-N! CE-KICK @ 0 PRIM-SINE  CE-BASS @ 1 PRIM-TRI  CE-CLAP @ 2 PRIM-NSE  CE-HAT @ 3 SHIM-HIHAT  CE-ARP @ 4 PRIM-SAW ENDOF
    6 VOICES-N! CE-KICK @ 0 PRIM-SINE  CE-BASS @ 1 PRIM-TRI  CE-CLAP @ 2 PRIM-NSE  CE-HAT @ 3 SHIM-HIHAT  CE-ARP @ 4 PRIM-SAW  CE-HARM @ 5 PRIM-TRI
  ENDCASE ;
