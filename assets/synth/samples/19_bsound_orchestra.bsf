\ @ID 19
\ @TITLE B-SOUND: ACOUSTIC & ORCHESTRA
\ @SUBTITLE ORCHESTRA §3 · PIANO, GUITAR, VIOLIN, CELLO
\ @CATEGORY B-SOUND DSP
\ @PARTS 4
\ @PART 1 shimGrandPiano (Am-F-Dm-E7)
\ @PART 2 shimPedalBass + shimGuitar
\ @PART 3 Violin LFO + Cello LPF
\ @PART 4 Full Chamber Ensemble
\ @SPEED 2.2
\ @REVERB 0.22
\ @FORMULA GrandPiano(PNO) · PedalBass(TRI) · Guitar(TRI) · Violin(LFO 5.8Hz) · Cello(LPF 520Hz)

VARIABLE BO-U  VARIABLE BO-BAR  VARIABLE BO-ST

: BO-ROOT ( bar -- hz )
  CASE 0 OF 110.0 ENDOF 1 OF 87.31 ENDOF 2 OF 73.42 ENDOF 82.41 SWAP ENDCASE ;

: BO-MEL ( st -- hz )
  8 IMOD CASE
    0 OF 440.0 ENDOF 1 OF 523.25 ENDOF 2 OF 659.25 ENDOF 3 OF 587.33 ENDOF
    4 OF 523.25 ENDOF 5 OF 493.88 ENDOF 6 OF 440.0 ENDOF 392.0 SWAP ENDCASE ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + DUP BO-U ! DUP 4.0 / FLOOR >INT 0 3 CLAMP BO-BAR !
  2.0 * FLOOR >INT BO-ST !
  CASE
    0 OF
      2 VOICES-N!
      BO-ST @ BO-MEL HZ>Y 0 SHIM-GRAND-PIANO
      BO-BAR @ BO-ROOT 2.0 * HZ>Y 1 SHIM-GRAND-PIANO
    ENDOF
    1 OF
      2 VOICES-N!
      BO-BAR @ BO-ROOT HZ>Y 0 SHIM-PEDAL-BASS
      BO-ST @ BO-MEL 0.5 * HZ>Y 1 SHIM-GUITAR
    ENDOF
    2 OF
      2 VOICES-N!
      BO-ST @ BO-MEL HZ>Y 5.8 0.022 0 PRIM-LFO
      BO-BAR @ BO-ROOT HZ>Y 520.0 2.2 1 PRIM-LPF
    ENDOF
    4 VOICES-N!
    BO-ST @ BO-MEL HZ>Y 0 SHIM-GRAND-PIANO
    BO-ST @ 2 + BO-MEL HZ>Y 5.8 0.020 1 PRIM-LFO
    BO-BAR @ BO-ROOT 2.0 * HZ>Y 2 SHIM-GUITAR
    BO-BAR @ BO-ROOT HZ>Y 520.0 2.2 3 PRIM-LPF
  ENDCASE ;
