    1 OF 2 IMOD 0 = IF 493.88 ELSE 659.25 THEN ENDOF
    2 OF 2 IMOD 0 = IF 523.25 ELSE 659.25 THEN ENDOF
    DROP CASE 0 OF 587.33 ENDOF 2 OF 523.25 ENDOF 4 OF 493.88 ENDOF 659.25 SWAP ENDCASE
  0 ENDCASE ;

