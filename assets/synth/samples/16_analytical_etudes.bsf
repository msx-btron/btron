  ENDCASE ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + DUP AE-U !
  4.0 / FLOOR >INT 0 3 CLAMP AE-BAR !

  CASE
    \ ── Etude 01: Broken Radio I ──
    0 OF
      1 VOICES-N!
      AE-U @ 8.0 - SIN 2.0 * SIN 3.0 * SIN 4.0 * SIN 5.0 * SIN 2.8 *
      2.76 1.8 0 PRIM-FM
    ENDOF

    \ ── Etude 02: Shortwave Beacon (Am9) ──
    1 OF
      4 VOICES-N!
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-SF @ 0.72 < IF AE-BAR @ AE-ST @ AE2-ARP HZ>Y ELSE QUIET THEN 0 PRIM-TRI
      AE-U @ 0.5 * FRAC 0.45 < IF
        AE-BAR @ CASE 0 OF 880.00 ENDOF 1 OF 698.46 ENDOF 2 OF 1046.50 ENDOF 783.99 SWAP ENDCASE HZ>Y
      ELSE QUIET THEN 2.76 1.8 1 PRIM-FM
      AE-ST @ 2 IMOD 1 = AE-SF @ 0.14 < AND IF 2.75 ELSE QUIET THEN 2400.0 1.4 2 PRIM-HPF
      AE-BAR @ CASE 0 OF 110.00 ENDOF 1 OF 87.31 ENDOF 2 OF 130.81 ENDOF 98.00 SWAP ENDCASE HZ>Y 520.0 2.0 3 PRIM-LPF
    ENDOF

    \ ── Etude 03: Chiptune Pulse (Em) ──
    2 OF
      4 VOICES-N!
      AE-U @ 3.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-SF @ 0.70 < IF AE-BAR @ AE-ST @ AE3-CH HZ>Y ELSE QUIET THEN 0 PRIM-PLS
      AE-BAR @ 0 AE3-CH 0.5 * HZ>Y 1 PRIM-TRI
      AE-U @ FRAC 0.4 * AE-BAR @ CASE 0 OF 82.41 ENDOF 1 OF 65.41 ENDOF 2 OF 98.00 ENDOF 73.42 SWAP ENDCASE 0.28 SHIM-WADDLE-Y 520.0 1.8 2 PRIM-LPF
      AE-ST @ 6 IMOD 3 = AE-SF @ 0.60 < AND IF AE-BAR @ 3 AE3-CH 2.0 * HZ>Y -3.0 3.0 CLAMP ELSE QUIET THEN 3 PRIM-SINE
    ENDOF

    \ ── Etude 04: Minimalist Pulse (Am Pent) ──
    3 OF
      4 VOICES-N!
      AE-U @ FLOOR >INT DUP AE-V1 !
      4 IMOD CASE 0 OF 2.0 ENDOF 1 OF 3.0 ENDOF 2 OF 4.0 ENDOF 2.0 SWAP ENDCASE
      AE-U @ FRAC * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-V1 @ AE-ST @ + 6 IMOD AE-V2 !
      AE-SF @ 0.72 < IF AE-V2 @ AE4-PENT HZ>Y ELSE QUIET THEN 0 PRIM-SINE
      AE-SF @ 0.55 < IF AE-V2 @ 2 + AE4-PENT 0.5 * HZ>Y ELSE QUIET THEN 1 PRIM-PLS
      AE-BAR @ CASE 0 OF 110.00 ENDOF 1 OF 110.00 ENDOF 2 OF 87.31 ENDOF 98.00 SWAP ENDCASE HZ>Y 520.0 1.8 2 PRIM-LPF
      AE-SF @ 0.16 < AE-ST @ 2 IMOD 0 = AND IF 2.65 ELSE QUIET THEN 3 PRIM-NSE
    ENDOF

    \ ── Etude 05: Cathedral Dawn (Am9) ──
    4 OF
      5 VOICES-N!
      AE-U @ 1.5 * DUP FRAC AE-SF ! FLOOR >INT 0 23 CLAMP AE-ST !
      AE-SF @ 0.86 < IF AE-ST @ AE5-ARP HZ>Y ELSE QUIET THEN 0 PRIM-SINE
      AE-U @ 12.0 < IF 55.00 ELSE 49.00 THEN HZ>Y 480.0 1.8 1 PRIM-LPF
      AE-U @ 2.0 > IF AE-U @ 8.0 < IF 261.63 ELSE 329.63 THEN HZ>Y ELSE QUIET THEN 2 PRIM-TRI
      AE-U @ 4.0 > IF AE-U @ 10.0 < IF 329.63 ELSE 440.00 THEN HZ>Y ELSE QUIET THEN 2.76 1.8 3 PRIM-FM
      AE-U @ 3.0 > IF 659.25 HZ>Y 0.05 AE-U @ 4.0 / FRAC * - ELSE QUIET THEN 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 06: Time Ostinato (Am-Em-G-D) ──
    5 OF
      5 VOICES-N!
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-BAR @ CASE 0 OF 55.00 ENDOF 1 OF 82.41 ENDOF 2 OF 98.00 ENDOF 73.42 SWAP ENDCASE AE-V1 !
      AE-BAR @ CASE 0 OF 440.00 ENDOF 1 OF 329.63 ENDOF 2 OF 392.00 ENDOF 293.66 SWAP ENDCASE AE-V2 !
      AE-BAR @ CASE 0 OF 523.25 ENDOF 1 OF 493.88 ENDOF 2 OF 493.88 ENDOF 440.00 SWAP ENDCASE AE-V3 !
      AE-SF @ 0.78 < IF
        AE-ST @ 2 IMOD 0 = IF AE-V2 @ ELSE AE-V3 @ THEN HZ>Y
        -8.0 AE-SF @ * EXP 0.03 * +
      ELSE QUIET THEN 0 PRIM-SINE
      AE-V3 @ 2.0 * HZ>Y 2PI 5.2 * AE-U @ * SIN 0.02 * + 5.2 0.02 1 PRIM-LFO
      AE-V1 @ HZ>Y 520.0 2.0 2 PRIM-LPF
      AE-V1 @ 3.0 * HZ>Y 3 PRIM-TRI
      AE-V2 @ HZ>Y 1.0 -2.0 AE-U @ 4.0 / FRAC * EXP - 0.06 * - 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 07: Cornfield Chase (3/4 Organ) ──
    6 OF
      6 VOICES-N!
      AE-U @ 3.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-BAR @ AE-ST @ AE7-PAT AE-V1 !
      AE-SF @ 0.82 < IF AE-V1 @ HZ>Y ELSE QUIET THEN 0 PRIM-SINE
      AE-U @ 6.0 >= AE-SF @ 0.72 < AND IF AE-V1 @ 2.0 * HZ>Y -3.0 3.0 CLAMP ELSE QUIET THEN 1 PRIM-TRI
      AE-BAR @ CASE 0 OF 174.61 ENDOF 1 OF 196.00 ENDOF 2 OF 220.00 ENDOF 164.81 SWAP ENDCASE HZ>Y 2.0 1.2 2 PRIM-FM
      AE-BAR @ CASE 0 OF 87.31  ENDOF 1 OF 98.00  ENDOF 2 OF 110.00 ENDOF 82.41  SWAP ENDCASE HZ>Y 480.0 2.0 3 PRIM-LPF
      AE-BAR @ CASE 0 OF 659.25 ENDOF 1 OF 783.99 ENDOF 2 OF 880.00 ENDOF 987.77 SWAP ENDCASE HZ>Y
      2PI 5.5 * AE-U @ * SIN 0.022 * + 5.5 0.022 4 PRIM-LFO
      659.25 HZ>Y 0.08 AE-U @ 4.0 / FRAC * - 0.34 5 PRIM-RVB
    ENDOF

    \ ── Etude 08: Dune / BR2049 (BRAAM) ──
    7 OF
      5 VOICES-N!
      AE-U @ 4.0 / FRAC AE-V2 !
      AE-BAR @ CASE 0 OF 55.00 ENDOF 1 OF 55.00 ENDOF 2 OF 65.41 ENDOF 49.00 SWAP ENDCASE AE-V1 !
      AE-V2 @ 0.72 < IF AE-V1 @ HZ>Y ELSE QUIET THEN 25.0 0 PRIM-SAT
      AE-V2 @ 0.72 < IF AE-V1 @ 1.5 * HZ>Y ELSE QUIET THEN 520.0 2.0 1 PRIM-LPF
      AE-V1 @ 4.0 * HZ>Y 2PI 4.8 * AE-U @ * SIN 0.025 * + 4.8 0.025 2 PRIM-LFO
      AE-U @ 1.5 * FRAC DUP 0.25 < IF 0.4 * 55.0 0.16 SHIM-KICK-Y ELSE DROP QUIET THEN 3 PRIM-SINE
      AE-V2 @ 0.55 >= IF AE-V1 @ 3.0 * HZ>Y 0.25 AE-V2 @ 0.55 - * - ELSE QUIET THEN 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 09: S.T.A.Y. (Music-Box) ──
    8 OF
      5 VOICES-N!
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT 4 IMOD
      CASE 0 OF 880.00 ENDOF 1 OF 659.25 ENDOF 2 OF 523.25 ENDOF 659.25 SWAP ENDCASE
      AE-SF @ 0.76 < IF HZ>Y ELSE DROP QUIET THEN 0 PRIM-SINE
      EV-RESET
      AE-U @ 0.0 220.00 3.8 EV  AE-U @ 4.0 246.94 3.8 EV
      AE-U @ 8.0 261.63 3.8 EV  AE-U @ 12.0 329.63 3.8 EV
      EV@ DUP AE-V1 ! 1 PRIM-TRI
      AE-V1 @ QUIET <> IF AE-V1 @ 1.0 + 2PI 5.6 * AE-U @ * SIN 0.022 * + ELSE QUIET THEN 5.6 0.022 2 PRIM-LFO
      AE-BAR @ CASE 0 OF 110.00 ENDOF 1 OF 87.31 ENDOF 2 OF 65.41 ENDOF 98.00 SWAP ENDCASE HZ>Y 500.0 1.8 3 PRIM-LPF
      659.25 HZ>Y 0.08 AE-U @ 4.0 / FRAC * - 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 10: Gladiator (D Dorian) ──
    9 OF
      5 VOICES-N!
      AE-U @ FLOOR >INT 0 15 CLAMP DUP AE-V1 !
      1 + 15 MIN AE-V2 !
      1.0 1.0 -14.0 AE-U @ FRAC 0.78 - * EXP + / AE-V3 !
      AE-V1 @ AE10-NOTE HZ>Y 1.0 AE-V3 @ - *
      AE-V2 @ AE10-NOTE HZ>Y AE-V3 @ * + DUP AE-V4 !
      0 PRIM-TRI
      AE-V4 @ 0.8480 + -3.0 3.0 CLAMP 1200.0 3.0 1 PRIM-BPF
      AE-BAR @ CASE 0 OF 293.66 ENDOF 1 OF 261.63 ENDOF 2 OF 233.08 ENDOF 220.00 SWAP ENDCASE HZ>Y
      2PI 5.4 * AE-U @ * SIN 0.02 * + 5.4 0.02 2 PRIM-LFO
      AE-BAR @ CASE 0 OF 73.42 ENDOF 1 OF 65.41 ENDOF 2 OF 58.27 ENDOF 73.42 SWAP ENDCASE HZ>Y 480.0 1.8 3 PRIM-LPF
      AE-V4 @ 0.05 - 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 11: No Time For Caution (3:4 Polyrhythm) ──
    10 OF
      5 VOICES-N!
      AE-U @ 1.5 * DUP FRAC 0.80 < IF FLOOR >INT AE-BAR @ SWAP AE11-CH HZ>Y ELSE DROP QUIET THEN 2.0 1.4 0 PRIM-FM
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-SF @ 0.78 < IF AE-BAR @ AE-ST @ AE11-CH 2.0 * HZ>Y ELSE QUIET THEN 1 PRIM-SINE
      AE-SF @ 0.45 < IF AE-BAR @ 0 AE11-CH 2.0 * HZ>Y ELSE QUIET THEN 2 PRIM-PLS
      AE-U @ FRAC 0.4 * AE-BAR @ CASE 0 OF 55.00 ENDOF 1 OF 43.65 ENDOF 2 OF 73.42 ENDOF 82.41 SWAP ENDCASE 0.16 SHIM-KICK-Y 420.0 2.0 3 PRIM-LPF
      AE-BAR @ 3 AE11-CH HZ>Y 0.05 AE-U @ 4.0 / FRAC * - 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 12: Sangreal Canon (Dm) ──
    11 OF
      5 VOICES-N!
      AE-U @ FLOOR >INT 0 15 CLAMP AE-ST !
      AE-ST @ AE12-VLN HZ>Y 2PI 5.6 * AE-U @ * SIN 0.024 * + DUP AE-V1 ! 5.6 0.024 0 PRIM-LFO
      AE-U @ 1.0 >= IF AE-ST @ AE12-ANS HZ>Y ELSE QUIET THEN 1 PRIM-TRI
      AE-BAR @ CASE 0 OF 73.42 ENDOF 1 OF 58.27 ENDOF 2 OF 65.41 ENDOF 55.00 SWAP ENDCASE HZ>Y 480.0 1.8 2 PRIM-LPF
      AE-U @ 2.0 * DUP FRAC 0.72 < IF FLOOR >INT AE-BAR @ SWAP AE12-HARP HZ>Y ELSE DROP QUIET THEN 3 PRIM-SINE
      AE-V1 @ 1.0 + 0.10 AE-U @ 4.0 / FRAC * - -3.0 3.0 CLAMP 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 13: Mombasa Chase (16th Ostinato) ──
    12 OF
      5 VOICES-N!
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-SF @ 0.78 < IF
        AE-ST @ 8 IMOD CASE
          0 OF 220.00 ENDOF 1 OF 220.00 ENDOF 2 OF 261.63 ENDOF 3 OF 220.00 ENDOF
          4 OF 293.66 ENDOF 5 OF 261.63 ENDOF 6 OF 220.00 ENDOF 196.00 SWAP
        ENDCASE HZ>Y
      ELSE QUIET THEN 20.0 0 PRIM-SAT
      AE-ST @ 8 IMOD DUP 0 = OVER 3 = OR SWAP 6 = OR IF
        AE-SF @ 0.25 * 0.18 SHIM-IND-KICK-Y
      ELSE QUIET THEN 480.0 2.0 1 PRIM-LPF
      EV-RESET
      AE-U @ 0.0 440.00 3.6 EV  AE-U @ 4.0 523.25 3.6 EV
      AE-U @ 8.0 587.33 3.6 EV  AE-U @ 12.0 659.25 3.8 EV
      EV@ 5.2 0.02 2 PRIM-LFO
      AE-ST @ 4 IMOD 2 = AE-SF @ 0.45 < AND IF 2.25 1.4 AE-SF @ * - ELSE QUIET THEN 3 PRIM-NSE
      AE-ST @ 2 IMOD 1 = AE-SF @ 0.22 < AND IF 2.82 ELSE QUIET THEN 3000.0 1.5 4 PRIM-HPF
    ENDOF

    \ ── Etude 14: Mountains Pendulum ──
    13 OF
      6 VOICES-N!
      AE-U @ 4.0 / FRAC AE-V1 !
      AE-U @ 1.25 * FRAC 0.12 < IF 2.86 ELSE QUIET THEN 3000.0 1.4 0 PRIM-HPF
      AE-BAR @ 1 AE14-CH HZ>Y 2.0 1.2 1 PRIM-FM
      AE-V1 @ 0.15 > IF AE-BAR @ 2 AE14-CH HZ>Y ELSE QUIET THEN 2 PRIM-SINE
      AE-BAR @ 0 AE14-CH HZ>Y 480.0 1.8 3 PRIM-LPF
      AE-V1 @ 0.30 > IF AE-BAR @ 3 AE14-CH HZ>Y 2PI 5.2 * AE-U @ * SIN 0.02 * + ELSE QUIET THEN 5.2 0.02 4 PRIM-LFO
      AE-BAR @ 3 AE14-CH HZ>Y 0.18 AE-V1 @ * - 0.34 5 PRIM-RVB
    ENDOF

    \ ── Etude 15: Flight Fanfare (D Major) ──
    14 OF
      6 VOICES-N!
      EV-RESET
      AE-U @ 0.0 369.99 1.8 EV   AE-U @ 2.0 392.00 1.8 EV   AE-U @ 4.0 440.00 3.6 EV
      AE-U @ 8.0 587.33 1.8 EV   AE-U @ 10.0 659.25 1.8 EV  AE-U @ 12.0 739.99 3.8 EV
      EV@ DUP AE-V1 ! 18.0 0 PRIM-SAT
      AE-V1 @ QUIET <> IF AE-V1 @ 1.0 + -3.0 3.0 CLAMP ELSE QUIET THEN DUP AE-V2 ! 5.4 0.02 1 PRIM-LFO
      AE-U @ 2.0 * DUP FRAC 0.78 < IF
        FLOOR >INT 4 IMOD CASE 0 OF 293.66 ENDOF 1 OF 440.00 ENDOF 2 OF 587.33 ENDOF 440.00 SWAP ENDCASE HZ>Y
      ELSE DROP QUIET THEN 2 PRIM-SINE
      AE-BAR @ CASE 0 OF 146.83 ENDOF 1 OF 146.83 ENDOF 2 OF 196.00 ENDOF 220.00 SWAP ENDCASE HZ>Y 3 PRIM-TRI
      AE-BAR @ CASE 0 OF 73.42  ENDOF 1 OF 73.42  ENDOF 2 OF 98.00  ENDOF 110.00 SWAP ENDCASE HZ>Y 480.0 1.8 4 PRIM-LPF
      AE-V2 @ QUIET <> IF AE-V2 @ 0.08 AE-U @ 4.0 / FRAC * - ELSE QUIET THEN 0.34 5 PRIM-RVB
    ENDOF

    \ ── Etude 16: Grand Symphony (8-Voice Climax) ──
    15 OF
      8 VOICES-N!
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT AE-ST !
      AE-BAR @ CASE 0 OF 659.25 ENDOF 1 OF 698.46 ENDOF 2 OF 783.99 ENDOF 880.00 SWAP ENDCASE HZ>Y AE-V1 !
      AE-SF @ 0.80 < IF AE-BAR @ AE-ST @ AE16-ARP HZ>Y ELSE QUIET THEN 0 PRIM-SINE
      AE-V1 @ 1 PRIM-TRI
      AE-V1 @ 2PI 5.8 * AE-U @ * SIN 0.025 * + 5.8 0.025 2 PRIM-LFO
      AE-BAR @ CASE 0 OF 440.00 ENDOF 1 OF 349.23 ENDOF 2 OF 523.25 ENDOF 587.33 SWAP ENDCASE HZ>Y 2.76 1.5 3 PRIM-FM
      AE-BAR @ CASE 0 OF 220.00 ENDOF 1 OF 174.61 ENDOF 2 OF 261.63 ENDOF 196.00 SWAP ENDCASE HZ>Y 520.0 2.0 4 PRIM-LPF
      AE-BAR @ CASE 0 OF 55.00  ENDOF 1 OF 43.65  ENDOF 2 OF 65.41  ENDOF 49.00  SWAP ENDCASE HZ>Y 22.0 5 PRIM-SAT
      AE-ST @ 4 IMOD 0 = AE-SF @ 0.25 < AND IF 1760.0 HZ>Y ELSE QUIET THEN 2800.0 1.4 6 PRIM-HPF
      AE-V1 @ 0.14 AE-U @ 4.0 / FRAC * - 0.34 7 PRIM-RVB
    ENDOF

    \ ── Etude 17: Aphex Twin — Bucephalus Bouncing Ball ──
    16 OF
      5 VOICES-N!
      AE-U @ 8.0 MOD AE-V1 !
      AE-U @ 8.0 / FLOOR >INT AE-V2 !
      1.0 AE-V1 @ 8.05 / - 0.0005 MAX LOG2 -0.358454 / FLOOR >INT 0 22 CLAMP AE-ST !
      AE-ST @ F16 -0.358454 * POW2 AE-V3 !
      AE-V1 @ 8.05 1.0 AE-V3 @ - * - 8.05 AE-V3 @ * 0.22 * 0.0005 MAX / 0.0 1.0 CLAMP AE-SF !
      4 AE-ST @ 3 I/ - 0 4 CLAMP AE-V4 !
      0.78 AE-ST @ F16 0.02 * - 0.28 MAX 0.76 MIN AE-V3 !
      AE-SF @ AE-V3 @ < IF
        AE-V2 @ AE-V4 @ AE-ST @ 2 IMOD + AE17-SCALE HZ>Y
        -10.0 AE-SF @ * EXP 0.025 * +
      ELSE QUIET THEN 0 PRIM-SINE
      AE-SF @ AE-V3 @ 0.85 * < IF AE-V2 @ AE-V4 @ AE17-SCALE 0.5 * HZ>Y ELSE QUIET THEN 1 PRIM-TRI
      AE-BAR @ CASE 0 OF 46.25 ENDOF 1 OF 55.00 ENDOF 2 OF 73.42 ENDOF 82.41 SWAP ENDCASE HZ>Y 480.0 1.8 2 PRIM-LPF
      AE-SF @ 0.09 < AE-ST @ 2 IMOD 0 = AND IF 2.82 ELSE QUIET THEN 3000.0 1.4 3 PRIM-HPF
      AE-V2 @ 0 = IF 554.37 ELSE 659.25 THEN HZ>Y 0.03 AE-U @ 8.0 / FRAC * - 0.34 4 PRIM-RVB
    ENDOF

    \ ── Etude 18: Hyperbolic & Exp Mosaic (Am9) ──
    17 OF
      5 VOICES-N!
      AE-U @ 2.0 * DUP FRAC AE-SF ! FLOOR >INT 0 31 CLAMP AE-ST !
      AE-ST @ 3 IMOD 0 = IF 0.48 ELSE AE-ST @ 2 IMOD 0 = IF 0.40 ELSE 0.34 THEN THEN AE-V1 !
      AE-ST @ AE18-FM DUP 0.0 > AE-SF @ AE-V1 @ < AND IF
        HZ>Y 0.34 AE-SF @ 0.30 + / + 0.48 - -2.8 2.8 CLAMP
      ELSE DROP QUIET THEN 2.76 1.6 0 PRIM-FM

      AE-ST @ 3 IMOD 1 = IF 0.46 ELSE 0.36 THEN AE-V1 !
      AE-SF @ AE-V1 @ / 0.0 1.0 CLAMP AE-V2 !
      AE-ST @ AE18-EXP DUP 0.0 > AE-SF @ AE-V1 @ < AND IF
        HZ>Y
        AE-ST @ 6 < AE-ST @ 15 >= AE-ST @ 22 < AND OR AE-ST @ 25 >= AE-ST @ 29 < AND OR IF
          2.3 AE-V2 @ * EXP 1.0 - 0.64 * 8.97418 /
        ELSE
          -4.6 AE-V2 @ * EXP 0.68 *
        THEN + -2.8 2.8 CLAMP
      ELSE DROP QUIET THEN 1 PRIM-TRI

      AE-BAR @ CASE 0 OF 329.63 ENDOF 1 OF 261.63 ENDOF 2 OF 392.00 ENDOF 293.66 SWAP ENDCASE HZ>Y 2 PRIM-SINE
      AE-BAR @ CASE 0 OF 55.00  ENDOF 1 OF 87.31  ENDOF 2 OF 65.41  ENDOF 98.00  SWAP ENDCASE HZ>Y 480.0 1.8 3 PRIM-LPF
      AE-BAR @ CASE 0 OF 440.00 ENDOF 1 OF 440.00 ENDOF 2 OF 659.25 ENDOF 493.88 SWAP ENDCASE HZ>Y 0.34 4 PRIM-RVB
    ENDOF
  ENDCASE ;
