    1 OF CASE 0 OF 261.63 ENDOF 1 OF 329.63 ENDOF 2 OF 392.00 ENDOF 3 OF 523.25 ENDOF 4 OF 392.00 ENDOF 329.63 SWAP ENDCASE ENDOF
