\ @ID 03
\ @TITLE MOTOR CHORD
\ @SUBTITLE 10.13.10 · MOTOR CHORD PROGRESSION
\ @CATEGORY MATH-SYNTH
\ @PARTS 4
\ @PART 1 Kick + Motor
\ @PART 2 + H(0) Root Glide
\ @PART 3 + H(7) Fifth
\ @PART 4 Full 6-Voice Triad
\ @SPEED 2.0
\ @FORMULA R(j)={0,1,3,4}[j mod 4], H(i)=(i+R(c)+(R(c+1)-R(c))*glide)/12-1

VARIABLE MC-Q
VARIABLE MC-C
VARIABLE MC-GL
VARIABLE MC-KICK
VARIABLE MC-MOT

: MC-R ( j -- r_f16 )
  4 IMOD CASE
    0 OF 0.0 ENDOF
    1 OF 1.0 ENDOF
    2 OF 3.0 ENDOF 4.0 SWAP ENDCASE ;

: MC-H ( i_f16 -- y )
  MC-C @ MC-R +
  MC-C @ 1 + MC-R MC-C @ MC-R - MC-GL @ * +
  12.0 / 1.0 - ;

: TRACK-EVAL ( x part -- )
  SWAP DUP 4.0 / DUP FRAC MC-Q ! FLOOR >INT 2 + MC-C !
  2.0 * DUP FRAC SWAP FLOOR >INT 16 + 8 IMOD
  DUP 0 = OVER 3 = OR SWAP 6 = OR IF 1.0 ELSE 0.0 THEN
  SWAP OVER 0.3 * 0.55 + < IF
    12.0 / 1.0 -
  ELSE DROP QUIET THEN MC-MOT !

  MC-Q @ 0.5 < IF -9.0 MC-Q @ * EXP 1.5 * 2.0 - ELSE QUIET THEN MC-KICK !
  MC-Q @ 0.85 - 0.15 / CLAMP01 MC-GL !

  CASE
    0 OF 2 VOICES-N! MC-KICK @ 0 PRIM-SINE  MC-MOT @ 1 PRIM-PLS ENDOF
    1 OF 3 VOICES-N! MC-KICK @ 0 PRIM-SINE  MC-MOT @ 1 PRIM-PLS  0.0 MC-H 2 PRIM-SAW ENDOF
    2 OF 4 VOICES-N! MC-KICK @ 0 PRIM-SINE  MC-MOT @ 1 PRIM-PLS  0.0 MC-H 2 PRIM-SAW  7.0 MC-H 3 PRIM-TRI ENDOF
    6 VOICES-N! MC-KICK @ 0 PRIM-SINE  MC-MOT @ 1 PRIM-PLS  0.0 MC-H 2 PRIM-SAW  7.0 MC-H 3 PRIM-TRI  12.0 MC-H 4 PRIM-SINE  16.0 MC-H 5 PRIM-SINE
  ENDCASE ;
