\ @ID 17
\ @TITLE B-SOUND: KINEMATIC SHIMS
\ @SUBTITLE B-SOUND §3 · SHIMS 1A-5 + FROG + BELL
\ @CATEGORY B-SOUND DSP
\ @PARTS 4
\ @PART 1 shimWaddle + shimDing
\ @PART 2 shimPulseSquash + shimFloat
\ @PART 3 shimFrogCroak (32Hz AM)
\ @PART 4 shimPulseBell + Mascot Suite
\ @SPEED 2.2
\ @FORMULA Kinematic Mascot Shims: Waddle(LPF) · Ding(SINE) · Frog(AM) · PulseBell(FM)

VARIABLE BK-U  VARIABLE BK-T

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + DUP BK-U ! FRAC BK-T !
  CASE
    0 OF
      2 VOICES-N!
      BK-T @ 0.25 * 146.83 0.14 0 SHIM-WADDLE
      BK-T @ 0.35 < IF 1760.0 HZ>Y ELSE QUIET THEN 1 SHIM-DING
    ENDOF
    1 OF
      3 VOICES-N!
      BK-T @ 1.0 0 SHIM-PULSE-SQUASH
      523.25 HZ>Y 1 SHIM-FLOAT
      659.25 HZ>Y 2 SHIM-FLOAT
    ENDOF
    2 OF
      2 VOICES-N!
      BK-T @ 0.5 * 125.0 0.19 0 SHIM-FROG-CROAK
      BK-T @ 0.5 * 0.25 - 155.0 0.095 1 SHIM-FROG-CROAK
    ENDOF
    4 VOICES-N!
    BK-T @ 0.25 * 146.83 0.14 0 SHIM-WADDLE
    BK-U @ 2.0 * FLOOR >INT 4 IMOD
    CASE 0 OF 587.33 ENDOF 1 OF 739.99 ENDOF 2 OF 880.0 ENDOF 1174.66 SWAP ENDCASE HZ>Y 1 SHIM-DANCE
    BK-T @ 0.5 * 125.0 0.19 2 SHIM-FROG-CROAK
    261.63 HZ>Y 3 SHIM-PULSE-BELL
  ENDCASE ;
