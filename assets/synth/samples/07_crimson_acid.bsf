\ @ID 07
\ @TITLE CRIMSON ACID
\ @SUBTITLE 10.18.45 · PENTATONIC 303 ACID
\ @CATEGORY MATH-SYNTH
\ @PARTS 4
\ @PART 1 Kick + Groove
\ @PART 2 + Fifth + Hats
\ @PART 3 Acid Line Focus
\ @PART 4 Full 5-Voice Acid
\ @SPEED 2.05
\ @FORMULA kick=-2+3e^(-20*frac(x)), acid=(h(n(s))-12*O)/12 + 0.3e^(-14f)

VARIABLE CA-B  VARIABLE CA-S  VARIABLE CA-F  VARIABLE CA-K  VARIABLE CA-R
VARIABLE CA-KICK  VARIABLE CA-G  VARIABLE CA-HAT  VARIABLE CA-ACID

: TRACK-EVAL ( x part -- )
  SWAP DUP 8.0 + 4.0 / FLOOR >INT 0 3 CLAMP CA-B !
  DUP FRAC DUP 0.25 < IF -20.0 * EXP 3.0 * 2.0 - ELSE DROP QUIET THEN CA-KICK !
  4.0 * DUP FRAC CA-F ! FLOOR >INT 32 + DUP CA-S ! 16 IMOD CA-K !

  CA-B @ CASE 0 OF 0 ENDOF 1 OF 0 ENDOF 2 OF -4 ENDOF -5 SWAP ENDCASE CA-R !
  CA-F @ 0.65 < IF
    CA-R @ CA-S @ 4 IMOD 3 = IF 7 + THEN F16 12.0 / 1.0 -
    -12.0 CA-F @ * EXP 0.08 * +
  ELSE QUIET THEN CA-G !

  61132 CA-K @ BIT CA-F @ 0.22 < AND IF 2.25 2.0 CA-F @ * - ELSE QUIET THEN CA-HAT !
  27995 CA-K @ BIT CA-F @ 0.8 < AND IF
    203043 7 CA-S @ 8 IMOD - DIGIT 12 I* 3 + 5 I/
    CA-K @ 6 = IF 12 - THEN F16 12.0 /
    CA-S @ 3 IMOD 0 = IF -14.0 CA-F @ * EXP 0.3 * + THEN
  ELSE QUIET THEN CA-ACID !

  CASE
    0 OF 2 VOICES-N! CA-KICK @ 0 PRIM-SINE  CA-G @ 1 PRIM-TRI ENDOF
    1 OF 4 VOICES-N! CA-KICK @ 0 PRIM-SINE  CA-G @ 1 PRIM-TRI  CA-G @ 0.5833 + 2 PRIM-SAW  CA-HAT @ 3 SHIM-HIHAT ENDOF
    2 OF 3 VOICES-N! CA-G @ 0.5833 + 0 PRIM-SAW  CA-HAT @ 1 SHIM-HIHAT  CA-ACID @ 2 20.0 PRIM-SAT ENDOF
    5 VOICES-N! CA-KICK @ 0 PRIM-SINE  CA-G @ 1 PRIM-TRI  CA-G @ 0.5833 + 2 PRIM-SAW  CA-ACID @ 3 20.0 PRIM-SAT  CA-HAT @ 4 SHIM-HIHAT
  ENDCASE ;
