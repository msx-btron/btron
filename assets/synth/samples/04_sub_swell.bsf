\ @ID 04
\ @TITLE SUB SWELL
\ @SUBTITLE 10.14.03 · SIN^2 HARMONIC SWELL
\ @CATEGORY MATH-SYNTH
\ @PARTS 3
\ @PART 1 V(-12), V(1)
\ @PART 2 4-Voice Swell
\ @PART 3 4-Voice + Sub Gate
\ @SPEED 1.5
\ @FORMULA V(i) = i*s/12, s = sin^2(pi * frac(x/8)), sub = -2 if s > 0.5

VARIABLE SS-S
: SS-V ( i_f16 -- y ) SS-S @ * 12.0 / ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 / FRAC PI * SIN DUP * SS-S !
  CASE
    0 OF 2 VOICES-N! -12.0 SS-V 0 PRIM-SINE  1.0 SS-V 1 PRIM-TRI ENDOF
    1 OF 4 VOICES-N! -12.0 SS-V 0 PRIM-SINE  -5.0 SS-V 1 PRIM-TRI  1.0 SS-V 2 PRIM-SAW  8.0 SS-V 3 PRIM-SINE ENDOF
    5 VOICES-N! -12.0 SS-V 0 PRIM-SINE  -5.0 SS-V 1 PRIM-TRI  1.0 SS-V 2 PRIM-SAW  8.0 SS-V 3 PRIM-SINE
    SS-S @ 0.5 > IF -2.0 ELSE QUIET THEN 4 PRIM-SINE
  ENDCASE ;
