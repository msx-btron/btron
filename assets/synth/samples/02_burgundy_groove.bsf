\ @ID 02
\ @TITLE BURGUNDY GROOVE
\ @SUBTITLE 10.11.07 · POLYPHONIC GROOVE
\ @CATEGORY MATH-SYNTH
\ @PARTS 6
\ @PART 1 Kick + N(0)
\ @PART 2 Kick + N(0,7)
\ @PART 3 Kick + N(0,7,12)
\ @PART 4 + Tom Fill
\ @PART 5 + C(14) Glide
\ @PART 6 Full 7-Voice Groove
\ @SPEED 2.0
\ @FORMULA kick=1.3e^(-5g)-2, tom=0.6e^(-9f)-1.2, N(i)=(i+(G=10)-2*clamp((g-1.5)/2,0,1))/12-1

VARIABLE BG-X
VARIABLE BG-M
VARIABLE BG-F
VARIABLE BG-G
VARIABLE BG-G0
VARIABLE BG-KICK
VARIABLE BG-TOM

: BG-N ( i_f16 -- y )
  BG-G @ 3.5 < IF
    BG-G0 @ 10 = IF 1.0 + THEN
    BG-G @ 1.5 - 2.0 / CLAMP01 2.0 * -
    12.0 / 1.0 -
  ELSE DROP QUIET THEN ;

: BG-C ( i_f16 -- y )
  BG-X @ 0.0 > BG-X @ 7.8 < AND IF
    BG-X @ 4.0 / + 12.0 /
  ELSE DROP QUIET THEN ;

: TRACK-EVAL ( x part -- )
  SWAP DUP BG-X !
  2.0 * DUP FRAC BG-F !
  FLOOR >INT 16 + 16 IMOD DUP BG-M !
  DUP 5 < IF DROP 0 ELSE DUP 10 < IF DROP 5 ELSE DROP 10 THEN THEN BG-G0 !
  BG-M @ F16 BG-F @ + BG-G0 @ F16 - BG-G !

  BG-G @ 0.8 < IF -5.0 BG-G @ * EXP 1.3 * 2.0 - ELSE QUIET THEN BG-KICK !
  BG-M @ 3 = BG-M @ 8 = OR BG-M @ 12 > OR BG-F @ 0.6 < AND IF
    -9.0 BG-F @ * EXP 0.6 * 1.2 -
    BG-M @ 12 > IF BG-M @ 13 - F16 8.0 / + THEN
  ELSE QUIET THEN BG-TOM !

  CASE
    0 OF 2 VOICES-N! BG-KICK @ 0 PRIM-SINE  0.0 BG-N 1 PRIM-TRI ENDOF
    1 OF 3 VOICES-N! BG-KICK @ 0 PRIM-SINE  0.0 BG-N 1 PRIM-TRI  7.0 BG-N 2 PRIM-SAW ENDOF
    2 OF 4 VOICES-N! BG-KICK @ 0 PRIM-SINE  0.0 BG-N 1 PRIM-TRI  7.0 BG-N 2 PRIM-SAW  12.0 BG-N 3 PRIM-PLS ENDOF
    3 OF 5 VOICES-N! BG-KICK @ 0 PRIM-SINE  BG-TOM @ 1 PRIM-TRI  0.0 BG-N 2 PRIM-TRI  7.0 BG-N 3 PRIM-SAW  12.0 BG-N 4 PRIM-PLS ENDOF
    4 OF 6 VOICES-N! BG-KICK @ 0 PRIM-SINE  BG-TOM @ 1 PRIM-TRI  0.0 BG-N 2 PRIM-TRI  7.0 BG-N 3 PRIM-SAW  12.0 BG-N 4 PRIM-PLS  14.0 BG-C 5 SHIM-PULSE-BELL ENDOF
    7 VOICES-N! BG-KICK @ 0 PRIM-SINE  BG-TOM @ 1 PRIM-TRI  0.0 BG-N 2 PRIM-TRI  7.0 BG-N 3 PRIM-SAW  12.0 BG-N 4 PRIM-PLS  14.0 BG-C 5 SHIM-PULSE-BELL  15.0 BG-C 6 PRIM-SINE
  ENDCASE ;
