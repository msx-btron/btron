\ @ID 14
\ @TITLE SAPPHIRE ARP
\ @SUBTITLE 10.27.33 · ACID BASS & CHORD ARPEGGIO
\ @CATEGORY MATH-SYNTH
\ @PARTS 2
\ @PART 1 Kick + Acid Bass
\ @PART 2 + 16th Chord Stabs
\ @SPEED 2.0
\ @FORMULA kick=-1.6+2.6e^(-24*frac(u)), bass=-1.25+(7+rOff+d(30703570))/12

VARIABLE SA-U  VARIABLE SA-Q  VARIABLE SA-ROFF

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + DUP SA-U !
  4.0 / FLOOR >INT DUP SA-Q !
  DUP 2 = IF DROP -4 ELSE 3 = IF -2 ELSE 0 THEN THEN SA-ROFF !

  1 VOICES-N!
  SA-U @ FRAC DUP 0.22 < IF
    -24.0 * EXP 2.6 * 1.6 - 0 PRIM-SINE DROP EXIT
  ELSE DROP THEN

  SA-U @ 4.0 * DUP FRAC SWAP FLOOR >INT
  ROT 1 = OVER 16 IMOD 13 >= AND IF
    2DROP
    SA-U @ 16.0 * FLOOR >INT 4 IMOD
    CASE 0 OF 0 ENDOF 1 OF 3 ENDOF 2 OF 7 ENDOF 10 SWAP ENDCASE
    24 + SA-ROFF @ + F16 12.0 / 1.25 - 0 PRIM-SAW EXIT
  THEN
  SWAP DUP 0.8 < IF
    SWAP 8 IMOD 7 SWAP - 30703570 SWAP DIGIT
    7 + SA-ROFF @ + F16 12.0 / 1.25 -
    SWAP -9.0 * EXP 0.2 * + 0 PRIM-TRI
  ELSE 2DROP QUIET 0 PRIM-TRI THEN ;
