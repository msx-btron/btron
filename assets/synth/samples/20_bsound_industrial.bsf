\ @ID 20
\ @TITLE B-SOUND: INDUSTRIAL & SWARM
\ @SUBTITLE MEDIA-SOUND §5 · IND-KICK, BASS, SWARM, CYBER LEAD
\ @CATEGORY B-SOUND DSP
\ @PARTS 4
\ @PART 1 shimIndustrialKick + Snare
\ @PART 2 shimIndustrialBass (16th)
\ @PART 3 shimCyberLead (TRON Sync)
\ @PART 4 Full Cyber-Grid Finale
\ @SPEED 2.8
\ @REVERB 0.30
\ @FORMULA IndKick(160->42Hz C25) · IndBass(LP->C20) · CyberLead(LP->C25)

VARIABLE BI-U  VARIABLE BI-S  VARIABLE BI-F

: BI-BASS-HZ ( s -- hz )
  8 IMOD CASE
    0 OF 55.0 ENDOF 1 OF 55.0 ENDOF 2 OF 65.41 ENDOF 3 OF 73.42 ENDOF
    4 OF 65.41 ENDOF 5 OF 55.0 ENDOF 6 OF 49.0 ENDOF 55.0 SWAP ENDCASE ;

: BI-LEAD-HZ ( s -- hz )
  8 IMOD CASE
    0 OF 440.0 ENDOF 1 OF 523.25 ENDOF 2 OF 493.88 ENDOF 3 OF 392.0 ENDOF
    4 OF 440.0 ENDOF 5 OF 587.33 ENDOF 6 OF 523.25 ENDOF 440.0 SWAP ENDCASE ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + DUP BI-U ! 2.0 * DUP FRAC BI-F ! FLOOR >INT BI-S !
  CASE
    0 OF
      2 VOICES-N!
      BI-S @ 4 IMOD 0 = IF BI-F @ 0.25 * 0.22 0 SHIM-IND-KICK ELSE QUIET 25.0 0 PRIM-SAT THEN
      BI-S @ 4 IMOD 2 = BI-F @ 0.35 < AND IF 220.0 HZ>Y 1 SHIM-SNARE ELSE QUIET 1 SHIM-SNARE THEN
    ENDOF
    1 OF
      2 VOICES-N!
      BI-S @ 4 IMOD 0 = IF BI-F @ 0.25 * 0.22 0 SHIM-IND-KICK ELSE QUIET 25.0 0 PRIM-SAT THEN
      BI-S @ BI-BASS-HZ HZ>Y 1 SHIM-IND-BASS
    ENDOF
    2 OF
      2 VOICES-N!
      BI-S @ BI-LEAD-HZ HZ>Y 0 SHIM-CYBER-LEAD
      BI-S @ BI-BASS-HZ HZ>Y 1 SHIM-IND-BASS
    ENDOF
    4 VOICES-N!
    BI-S @ BI-LEAD-HZ HZ>Y 0 SHIM-CYBER-LEAD
    BI-S @ BI-BASS-HZ HZ>Y 1 SHIM-IND-BASS
    BI-S @ 4 IMOD 0 = IF BI-F @ 0.25 * 0.22 2 SHIM-IND-KICK ELSE QUIET 25.0 2 PRIM-SAT THEN
    BI-S @ 2 IMOD 1 = BI-F @ 0.20 < AND IF 2.6 3 SHIM-HIHAT ELSE QUIET 3 SHIM-HIHAT THEN
  ENDCASE ;
