\ @ID 05
\ @TITLE LIME BREAKBEAT
\ @SUBTITLE 10.15.38 · BITMASK BREAKBEAT
\ @CATEGORY MATH-SYNTH
\ @PARTS 4
\ @PART 1 Kick + Sub
\ @PART 2 + Clap + Hats
\ @PART 3 + Bell Tune
\ @PART 4 Full 6-Voice Breakbeat
\ @SPEED 2.1
\ @FORMULA km=68161601, kick=3.5e^(-5.5f)-2, tune=305010, hat=1.45-1.2*frac(hr*x)

VARIABLE LB-X  VARIABLE LB-U  VARIABLE LB-F  VARIABLE LB-S  VARIABLE LB-B  VARIABLE LB-K
VARIABLE LB-KICK  VARIABLE LB-SUB  VARIABLE LB-CLAP  VARIABLE LB-HAT  VARIABLE LB-BELL  VARIABLE LB-LEAD

: TRACK-EVAL ( x part -- )
  SWAP DUP LB-X ! DUP 8.0 + LB-U !
  DUP 4.0 * DUP FRAC LB-F ! FLOOR >INT 32 +
  DUP 32 IMOD LB-S ! 32 I/ LB-B !
  2.0 * FLOOR >INT 16 + LB-K !

  68161601 LB-S @ BIT IF -5.5 LB-F @ * EXP 3.5 * 2.0 - ELSE QUIET THEN LB-KICK !

  LB-S @ 20 < IF LB-B @ 0 = IF 0.0 ELSE -2.0 THEN ELSE LB-B @ 0 = IF 3.0 ELSE 1.0 THEN THEN
  12.0 / 2.0 -
  LB-S @ F16 LB-F @ + 28.0 - 4.0 / CLAMP01 DUP * 5.0 * 12.0 / -
  LB-S @ 16 < LB-S @ 6 IMOD 4 < AND LB-S @ 20 >= OR IF ELSE DROP QUIET THEN LB-SUB !

  LB-X @ 6.0 + 4.0 MOD DUP 0.15 < IF 6.0 * 1.32 SWAP - ELSE DROP QUIET THEN LB-CLAP !

  LB-X @ 2.0 * FRAC DUP 0.3 < IF 1.2 * 1.45 SWAP - ELSE DROP QUIET THEN LB-HAT !

  LB-X @ 2.0 * FRAC DUP 0.5 < IF
    -20.0 * EXP 0.05 *
    305010 7 LB-K @ 8 IMOD - DIGIT F16 12.0 / + 1.0 +
  ELSE DROP QUIET THEN LB-BELL !

  LB-S @ 20 < IF LB-B @ -2 I* F16
  ELSE LB-S @ 22 < IF -2.0
  ELSE LB-S @ 24 < IF 0.0
  ELSE LB-S @ 26 < IF 1.0
  ELSE LB-S @ 28 < IF 3.0
  ELSE LB-S @ 30 < IF 1.0
  ELSE LB-B @ 2 I* 2 - F16 THEN THEN THEN THEN THEN THEN
  12.0 / 2.0 + LB-LEAD !

  CASE
    0 OF 2 VOICES-N! LB-KICK @ 0 PRIM-SINE  LB-SUB @ 1 PRIM-TRI ENDOF
    1 OF 4 VOICES-N! LB-KICK @ 0 PRIM-SINE  LB-SUB @ 1 PRIM-TRI  LB-CLAP @ 2 PRIM-NSE  LB-HAT @ 3 SHIM-HIHAT ENDOF
    2 OF 5 VOICES-N! LB-KICK @ 0 PRIM-SINE  LB-SUB @ 1 PRIM-TRI  LB-BELL @ 2 SHIM-PULSE-BELL  LB-CLAP @ 3 PRIM-NSE  LB-HAT @ 4 SHIM-HIHAT ENDOF
    6 VOICES-N! LB-KICK @ 0 PRIM-SINE  LB-SUB @ 1 PRIM-TRI  LB-BELL @ 2 SHIM-PULSE-BELL  LB-CLAP @ 3 PRIM-NSE  LB-HAT @ 4 SHIM-HIHAT  LB-LEAD @ 5 PRIM-PLS
  ENDCASE ;
