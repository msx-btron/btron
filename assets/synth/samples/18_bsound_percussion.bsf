\ @ID 18
\ @TITLE B-SOUND: PERCUSSION DSP
\ @SUBTITLE B-SOUND §4 · KICK, SNARE, HIHAT, TIMPANI
\ @CATEGORY B-SOUND DSP
\ @PARTS 4
\ @PART 1 shimKick Breakbeat
\ @PART 2 shimSnare Backbeat
\ @PART 3 shimHiHat Sizzle Matrix
\ @PART 4 Full Percussion Suite
\ @SPEED 3.2
\ @FORMULA Kick(2.2f->0.75f) · Snare(BP 2.4kHz) · HiHat(HP 7.5kHz) · Waddle Bass

VARIABLE BP2-U  VARIABLE BP2-S  VARIABLE BP2-F

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + DUP BP2-U ! 2.0 * DUP FRAC BP2-F ! FLOOR >INT BP2-S !
  CASE
    0 OF
      1 VOICES-N!
      BP2-S @ 4 IMOD 0 = BP2-S @ 4 IMOD 2 = OR IF BP2-F @ 0.25 * 65.0 0.16 0 SHIM-KICK ELSE QUIET 0 PRIM-SINE THEN
    ENDOF
    1 OF
      2 VOICES-N!
      BP2-S @ 4 IMOD 0 = IF BP2-F @ 0.25 * 65.0 0.16 0 SHIM-KICK ELSE QUIET 0 PRIM-SINE THEN
      BP2-S @ 4 IMOD 2 = BP2-F @ 0.35 < AND IF 220.0 HZ>Y 1 SHIM-SNARE ELSE QUIET 1 SHIM-SNARE THEN
    ENDOF
    2 OF
      2 VOICES-N!
      BP2-F @ 0.22 < IF 2.6 0 SHIM-HIHAT ELSE QUIET 0 SHIM-HIHAT THEN
      BP2-S @ 4 IMOD 0 = IF BP2-F @ 0.25 * 65.0 0.16 1 SHIM-KICK ELSE QUIET 1 PRIM-SINE THEN
    ENDOF
    4 VOICES-N!
    BP2-S @ 4 IMOD 0 = BP2-S @ 8 IMOD 5 = OR IF BP2-F @ 0.25 * 65.0 0.16 0 SHIM-KICK ELSE QUIET 0 PRIM-SINE THEN
    BP2-S @ 4 IMOD 2 = BP2-F @ 0.35 < AND IF 175.0 HZ>Y 1 SHIM-SNARE ELSE QUIET 1 SHIM-SNARE THEN
    BP2-F @ 0.20 < IF 2.7 2 SHIM-HIHAT ELSE QUIET 2 SHIM-HIHAT THEN
    BP2-F @ 0.28 * 146.83 0.14 3 SHIM-WADDLE
  ENDCASE ;
