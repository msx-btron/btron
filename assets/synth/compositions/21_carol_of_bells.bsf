\ @ID 21
\ @TITLE TRACK 1: CAROL OF THE BELLS
\ @SUBTITLE 168 BPM 3/4 · E MINOR · 1:1 MEDIA.HTML T1
\ @CATEGORY COMPOSITION
\ @PARTS 8
\ @PART 1 Bars 1-3: Intro Bells, HiHat & 2x Octave
\ @PART 2 Bars 4-6: E2 Pickup & Em/D Groove
\ @PART 3 Bars 7-9: C/B Groove, Snare Roll & B5
\ @PART 4 Bars 10-12: Chiptune Counterpoint
\ @PART 5 Bars 13-15: Coin & Star Arpeggios
\ @PART 6 Bars 16-18: B7 Trill & 16th Speedrun
\ @PART 7 Bars 19-21: Octave Leaps & Fanfare Tutti
\ @PART 8 Bars 22-24: Cadence & E6-B5-E7 Starlight Coda
\ @SPEED 4.9778
\ @REVERB 0.16
\ @FORMULA 鐘のキャロル (168 BPM 3/4, 24 Bars = 25.71s): G5-F#5-G5-E5 · shimDing + shimWaddle + shimKick

0.35714 CONSTANT T1-BEAT
1.07143 CONSTANT T1-BAR
3.21429 CONSTANT T1-TPART

VARIABLE T1-T   VARIABLE T1-BIDX  VARIABLE T1-BT  VARIABLE T1-LT
VARIABLE T1-BELL VARIABLE T1-HBELL VARIABLE T1-KICK VARIABLE T1-SNHH VARIABLE T1-CHI

: T1-BBARS ( bar4 beat3 -- hz )
  SWAP 4 IMOD CASE
    0 OF CASE 0 OF 82.41 ENDOF 1 OF 123.47 ENDOF 164.81 SWAP ENDCASE ENDOF
    1 OF CASE 0 OF 73.42 ENDOF 1 OF 110.00 ENDOF 146.83 SWAP ENDCASE ENDOF
    2 OF CASE 0 OF 65.41 ENDOF 1 OF 98.00  ENDOF 130.81 SWAP ENDCASE ENDOF
    3 OF CASE 0 OF 61.74 ENDOF 1 OF 92.50  ENDOF 123.47 SWAP ENDCASE ENDOF
  ENDCASE ;

: T1-RUN17 ( s -- hz )
  CASE
    0 OF 659.25 ENDOF 1 OF 783.99 ENDOF 2 OF 987.77 ENDOF 3 OF 1318.51 ENDOF
    4 OF 1567.98 ENDOF 5 OF 1479.98 ENDOF 6 OF 1318.51 ENDOF 7 OF 1174.66 ENDOF
    8 OF 1046.50 ENDOF 9 OF 987.77 ENDOF 10 OF 880.00 ENDOF 783.99 SWAP ENDCASE ;

: T1-RUN18 ( s -- hz )
  CASE
    0 OF 739.99 ENDOF 1 OF 783.99 ENDOF 2 OF 880.00 ENDOF 3 OF 987.77 ENDOF
    4 OF 1046.50 ENDOF 5 OF 1174.66 ENDOF 6 OF 1318.51 ENDOF 7 OF 1479.98 ENDOF
    8 OF 1567.98 ENDOF 9 OF 1760.00 ENDOF 10 OF 1567.98 ENDOF 1479.98 SWAP ENDCASE ;

: T1-RUN19 ( s -- hz )
  CASE
    0 OF 1318.51 ENDOF 1 OF 987.77 ENDOF 2 OF 783.99 ENDOF 3 OF 659.25 ENDOF
    4 OF 783.99 ENDOF 5 OF 987.77 ENDOF 6 OF 1318.51 ENDOF 7 OF 1567.98 ENDOF
    8 OF 1975.53 ENDOF 9 OF 1567.98 ENDOF 10 OF 1318.51 ENDOF 987.77 SWAP ENDCASE ;

: T1-DANCE ( lt sc -- y )
  >R EV-RESET
  DUP 0.000 587.33 R@ * 0.18 EV
  DUP 0.085 739.99 R@ * 0.20 EV
  DUP 0.170 880.00 R@ * 0.22 EV
  DUP 0.255 1174.66 R@ * 0.28 EV
      0.370 1479.98 R> * 0.42 EV
  EV@ ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + 16.0 / T1-TPART * OVER F16 T1-TPART * + DUP T1-T !
  DUP T1-BAR / FLOOR >INT 0 23 CLAMP DUP T1-BIDX !
  F16 T1-BAR * - DUP T1-LT ! T1-BEAT / T1-BT !

  T1-BT @ 0.92 < IF 783.99 HZ>Y
  ELSE T1-BT @ 1.0 >= T1-BT @ 1.44 < AND IF 739.99 HZ>Y
  ELSE T1-BT @ 1.5 >= T1-BT @ 1.92 < AND IF 783.99 HZ>Y
  ELSE T1-BT @ 2.0 >= T1-BT @ 2.90 < AND IF 659.25 HZ>Y
  ELSE QUIET THEN THEN THEN THEN DUP T1-BELL !
  DUP QUIET <> IF 1.0 + -3.0 3.0 CLAMP ELSE DROP QUIET THEN T1-HBELL !
  T1-BT @ 0.45 < IF T1-BT @ T1-BEAT * 68.0 0.14 SHIM-KICK-Y ELSE QUIET THEN T1-KICK !
  T1-BT @ 1.0 >= T1-BT @ 1.32 < AND T1-BT @ 2.0 >= T1-BT @ 2.32 < AND OR IF
    2.35 1.3 T1-BT @ FRAC * -
  ELSE QUIET THEN T1-SNHH !
  164.81 HZ>Y T1-CHI !

  CASE
    0 OF
      6 VOICES-N!
      T1-BELL @ 0 PRIM-SINE
      T1-BIDX @ 2 = IF T1-HBELL @ ELSE QUIET THEN 1 PRIM-SINE
      T1-BIDX @ 0 = IF T1-CHI @ ELSE QUIET THEN 2 SHIM-PULSE-BELL
      QUIET 3 PRIM-TRI
      T1-BIDX @ 2 = IF T1-KICK @ ELSE QUIET THEN 4 PRIM-SINE
      T1-BIDX @ 1 >= T1-BT @ 1.0 >= T1-BT @ 1.25 < AND T1-BT @ 2.0 >= T1-BT @ 2.25 < AND OR AND IF
        2.75 T1-BT @ FRAC -
      ELSE QUIET THEN 5 PRIM-SINE
    ENDOF
    1 OF
      5 VOICES-N!
      T1-BELL @ 0 PRIM-SINE
      T1-BIDX @ 3 = IF T1-HBELL @ ELSE QUIET THEN 1 PRIM-SINE
      T1-BIDX @ 3 = IF
        T1-BT @ 2.0 >= IF T1-BT @ 2.0 - T1-BEAT * 82.41 0.16 SHIM-WADDLE-Y ELSE QUIET THEN
      ELSE
        T1-BT @ FRAC T1-BEAT * T1-BIDX @ 4 - T1-BT @ FLOOR >INT 0 2 CLAMP T1-BBARS 0.16 SHIM-WADDLE-Y
      THEN 2 PRIM-TRI
      T1-KICK @ 3 PRIM-SINE
      T1-SNHH @ 4 PRIM-SINE
    ENDOF
    2 OF
      5 VOICES-N!
      T1-BELL @ 0 PRIM-SINE
      T1-BT @ FRAC T1-BEAT * T1-BIDX @ 4 - T1-BT @ FLOOR >INT 0 2 CLAMP T1-BBARS 0.16 SHIM-WADDLE-Y 1 PRIM-TRI
      T1-BIDX @ 8 = T1-BT @ 2.5 < AND IF 987.77 HZ>Y ELSE QUIET THEN 2 PRIM-SINE
      T1-KICK @ 3 PRIM-SINE
      T1-BIDX @ 7 = T1-BT @ 2.25 >= AND T1-BT @ 2.85 < AND T1-BT @ 4.0 * FRAC 0.72 < AND IF
        2.48 0.9 T1-BT @ 4.0 * FRAC * -
      ELSE T1-SNHH @ THEN 4 PRIM-SINE
    ENDOF
    3 OF
      5 VOICES-N!
      T1-BELL @ 0 PRIM-SINE
      T1-BT @ FRAC T1-BEAT * T1-BIDX @ 4 - T1-BT @ FLOOR >INT 0 2 CLAMP T1-BBARS 0.16 SHIM-WADDLE-Y 1 PRIM-TRI
      T1-BIDX @ 9 = IF
        T1-BT @ FLOOR >INT 0 2 CLAMP CASE 0 OF 1046.50 ENDOF 1 OF 987.77 ENDOF 880.00 SWAP ENDCASE HZ>Y
      ELSE T1-BIDX @ 10 = IF
        T1-BT @ FLOOR >INT 0 2 CLAMP CASE 0 OF 783.99 ENDOF 1 OF 880.00 ENDOF 987.77 SWAP ENDCASE HZ>Y
      ELSE T1-BIDX @ 11 = T1-BT @ 2.4 < AND IF 659.25 HZ>Y ELSE QUIET THEN THEN THEN 2 PRIM-SINE
      T1-KICK @ 3 PRIM-SINE
      T1-SNHH @ 4 PRIM-SINE
    ENDOF
    4 OF
      5 VOICES-N!
      T1-BELL @ 0 PRIM-SINE
      T1-BT @ FRAC T1-BEAT * T1-BIDX @ 12 - T1-BT @ FLOOR >INT 0 2 CLAMP T1-BBARS 0.16 SHIM-WADDLE-Y 1 PRIM-TRI
      T1-LT @ T1-BIDX @ 12 - CASE 0 OF 1.0 ENDOF 1 OF 0.89 ENDOF 0.79 SWAP ENDCASE T1-DANCE 2 PRIM-SINE
      T1-KICK @ 3 PRIM-SINE
      T1-SNHH @ 4 PRIM-SINE
    ENDOF
    5 OF
      5 VOICES-N!
      T1-BT @ 4.0 * FLOOR >INT 0 11 CLAMP
      T1-BIDX @ 15 = IF
        DUP 4 < IF CASE 0 OF 987.77 ENDOF 1 OF 1046.50 ENDOF 2 OF 1174.66 ENDOF 1244.51 SWAP ENDCASE HZ>Y ELSE DROP QUIET THEN
      ELSE
        T1-BT @ 4.0 * FRAC 0.82 < IF
          T1-BIDX @ 16 = IF T1-RUN17 ELSE T1-RUN18 THEN HZ>Y -3.0 3.0 CLAMP
        ELSE DROP QUIET THEN
      THEN 0 PRIM-SINE
      T1-BT @ FRAC T1-BEAT *
      T1-BIDX @ 15 = IF 3 T1-BT @ FLOOR >INT 0 2 CLAMP T1-BBARS
      ELSE T1-BIDX @ 16 = IF T1-BT @ FLOOR >INT 0 2 CLAMP CASE 0 OF 82.41 ENDOF 1 OF 82.41 ENDOF 164.81 SWAP ENDCASE
      ELSE T1-BT @ FLOOR >INT 0 2 CLAMP CASE 0 OF 65.41 ENDOF 1 OF 61.74 ENDOF 123.47 SWAP ENDCASE THEN THEN
      0.16 SHIM-WADDLE-Y 1 PRIM-TRI
      T1-BIDX @ 16 = IF
        EV-RESET T1-BT @ DUP 0.0 1318.51 0.8 EV DUP 1.0 1567.98 0.8 EV 2.0 1046.50 0.8 EV EV@
      ELSE QUIET THEN 2 PRIM-TRI
      T1-KICK @ 3 PRIM-SINE
      T1-SNHH @ 4 PRIM-SINE
    ENDOF
    6 OF
      6 VOICES-N!
      T1-BIDX @ 18 = IF
        T1-BT @ 4.0 * FRAC 0.82 < IF T1-BT @ 4.0 * FLOOR >INT 0 11 CLAMP T1-RUN19 HZ>Y -3.0 3.0 CLAMP ELSE QUIET THEN 0 PRIM-SINE
        QUIET 1 PRIM-SINE
      ELSE T1-BIDX @ 19 = IF
        T1-BT @ 4.0 * FLOOR >INT 0 11 CLAMP DUP 4 < IF
          CASE 0 OF 1244.51 ENDOF 1 OF 1479.98 ENDOF 2 OF 1760.00 ENDOF 1975.53 SWAP ENDCASE HZ>Y -3.0 3.0 CLAMP
        ELSE DROP T1-BT @ 2.0 >= IF 1567.98 HZ>Y -3.0 3.0 CLAMP ELSE QUIET THEN THEN 0 PRIM-SINE
        QUIET 1 PRIM-SINE
      ELSE
        T1-BELL @ 0 PRIM-SINE  T1-HBELL @ 1 PRIM-SINE
      THEN THEN
      T1-BT @ FRAC T1-BEAT *
      T1-BIDX @ 19 = IF 3 ELSE 0 THEN T1-BT @ FLOOR >INT 0 2 CLAMP T1-BBARS
      0.16 SHIM-WADDLE-Y 2 PRIM-TRI
      T1-KICK @ 3 PRIM-SINE
      T1-SNHH @ 4 PRIM-SINE
      T1-BIDX @ 20 = IF T1-CHI @ ELSE QUIET THEN 5 SHIM-PULSE-BELL
    ENDOF
    \ Part 8: Bars 22-24
    6 VOICES-N!
    T1-BIDX @ 21 = IF
      T1-BELL @ 0 PRIM-SINE
      T1-LT @ 1.0 T1-DANCE 1 PRIM-SINE
      T1-BT @ FRAC T1-BEAT * T1-BT @ FLOOR >INT 0 2 CLAMP CASE 0 OF 65.41 ENDOF 1 OF 61.74 ENDOF 82.41 SWAP ENDCASE 0.16 SHIM-WADDLE-Y 2 PRIM-TRI
      T1-KICK @ 3 PRIM-SINE  T1-SNHH @ 4 PRIM-SINE  QUIET 5 SHIM-PULSE-BELL
    ELSE T1-BIDX @ 22 = IF
      1318.51 HZ>Y 0 PRIM-SINE
      T1-BT @ 2.0 >= IF 3.0 ELSE QUIET THEN 1 PRIM-SINE
      T1-BT @ 0.6 < IF T1-BT @ T1-BEAT * 82.41 0.16 SHIM-WADDLE-Y ELSE QUIET THEN 2 PRIM-TRI
      QUIET 3 PRIM-SINE  QUIET 4 PRIM-SINE  T1-CHI @ 5 SHIM-PULSE-BELL
    ELSE
      EV-RESET T1-LT @ DUP 0.0 1318.51 0.34 EV DUP 0.357 987.77 0.34 EV 0.714 1760.0 0.80 EV EV@ 0 PRIM-SINE
      T1-LT @ 0.714 >= IF 3.0 ELSE QUIET THEN 1 PRIM-SINE
      QUIET 2 PRIM-TRI  QUIET 3 PRIM-SINE  QUIET 4 PRIM-SINE  T1-CHI @ 5 SHIM-PULSE-BELL
    THEN THEN
  ENDCASE ;
