\ Chord index per bar (0=Am, 1=C, 2=D, 3=F, 4=E, 5=E7)
: T3-CHORD-ID ( bIdx -- cid )
  CASE
    0 OF 0 ENDOF 1 OF 1 ENDOF 2 OF 0 ENDOF 3 OF 1 ENDOF 4 OF 2 ENDOF 5 OF 3 ENDOF
    6 OF 0 ENDOF 7 OF 1 ENDOF 8 OF 4 ENDOF 9 OF 5 ENDOF 10 OF 0 ENDOF 11 OF 1 ENDOF
    12 OF 2 ENDOF 13 OF 3 ENDOF 14 OF 0 ENDOF 15 OF 5 ENDOF 0 SWAP ENDCASE ;

: T3-CHORD-B ( cid -- hz )
  CASE 0 OF 55.0 ENDOF 1 OF 65.41 ENDOF 2 OF 73.42 ENDOF 3 OF 87.31 ENDOF 82.41 SWAP ENDCASE ;

: T3-ARP-HZ ( cid eIdx -- hz )
  SWAP CASE
    0 OF CASE 0 OF 110.0 ENDOF 1 OF 164.81 ENDOF 2 OF 220.0 ENDOF 3 OF 261.63 ENDOF 4 OF 164.81 ENDOF 261.63 SWAP ENDCASE ENDOF
    1 OF CASE 0 OF 130.81 ENDOF 1 OF 196.0 ENDOF 2 OF 261.63 ENDOF 3 OF 329.63 ENDOF 4 OF 196.0 ENDOF 329.63 SWAP ENDCASE ENDOF
    2 OF CASE 0 OF 146.83 ENDOF 1 OF 220.0 ENDOF 2 OF 293.66 ENDOF 3 OF 369.99 ENDOF 4 OF 220.0 ENDOF 369.99 SWAP ENDCASE ENDOF
    3 OF CASE 0 OF 174.61 ENDOF 1 OF 261.63 ENDOF 2 OF 349.23 ENDOF 3 OF 349.23 ENDOF 4 OF 261.63 ENDOF 349.23 SWAP ENDCASE ENDOF
    4 OF CASE 0 OF 164.81 ENDOF 1 OF 246.94 ENDOF 2 OF 329.63 ENDOF 3 OF 415.30 ENDOF 4 OF 246.94 ENDOF 415.30 SWAP ENDCASE ENDOF
    5 OF CASE 0 OF 164.81 ENDOF 1 OF 293.66 ENDOF 2 OF 329.63 ENDOF 3 OF 415.30 ENDOF 4 OF 293.66 ENDOF 415.30 SWAP ENDCASE ENDOF
  ENDCASE ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + 16.0 / T3-TPART * OVER F16 T3-TPART * + DUP T3-T !
  DUP T3-BAR / FLOOR >INT 0 17 CLAMP DUP T3-BIDX !
  F16 T3-BAR * - DUP T3-BT !
  T3-EIGHTH / DUP FRAC T3-EFRAC ! FLOOR >INT 0 5 CLAMP T3-EIDX !

  T3-BIDX @ T3-CHORD-ID DUP T3-CHORD-B HZ>Y T3-PED !
  T3-EIDX @ T3-ARP-HZ
  T3-BIDX @ 16 < T3-EFRAC @ 0.84 < AND IF DUP HZ>Y ELSE QUIET THEN T3-ARP1 !
  T3-BIDX @ 16 < T3-EFRAC @ 0.55 < AND IF 2.002 * HZ>Y ELSE DROP QUIET THEN T3-ARP2 !

  T3-BIDX @ 0 = T3-BT @ 0.60 < AND
  T3-BIDX @ 9 = T3-BT @ 0.50 < AND OR
  T3-BIDX @ 17 = T3-BT @ 0.80 < AND OR IF
    450.0 HZ>Y T3-BT @ 0.60 / -0.6845 * +
  ELSE QUIET THEN T3-SW !

  T3-T @ T3-MEL-EV DUP T3-MEL !
  T3-T @ 14.40 >= T3-T @ 23.40 < AND OVER QUIET <> AND IF 1.0 + -3.0 3.0 CLAMP ELSE DROP QUIET THEN T3-MOCT !
  T3-EIDX @ 0 = T3-EFRAC @ 0.16 < AND T3-T @ 14.40 >= AND IF
    120.0 HZ>Y T3-EFRAC @ 0.16 / -1.5850 * +
  ELSE QUIET THEN T3-HAM !

  DUP 0 = IF
    DROP 5 VOICES-N!
    T3-ARP1 @ 0 SHIM-GRAND-PIANO  T3-ARP2 @ 1 PRIM-TRI  T3-PED @ 2 PRIM-TRI  T3-SW @ 0.32 3 PRIM-RVB
    T3-T @ 0.80 < IF 880.0 HZ>Y ELSE T3-T @ 1.44 >= T3-T @ 2.34 < AND IF 880.0 HZ>Y ELSE T3-MEL @ THEN THEN 4 PRIM-SINE EXIT
  THEN
  DUP 3 <= IF
    5 VOICES-N!
    T3-MEL @ 0 SHIM-GRAND-PIANO  T3-MEL @ 1 PRIM-TRI  T3-ARP1 @ 2 PRIM-SINE  T3-PED @ 3 PRIM-TRI
    3 = IF T3-SW @ 0.32 4 PRIM-RVB ELSE T3-ARP2 @ 4 PRIM-TRI THEN EXIT
  THEN
  DUP 6 <= IF
    DROP 6 VOICES-N!
    T3-MEL @ 0 SHIM-GRAND-PIANO  T3-MOCT @ 1 SHIM-GRAND-PIANO  T3-ARP1 @ 2 PRIM-TRI
    T3-ARP2 @ 3 PRIM-SINE  T3-PED @ 4 PRIM-TRI  T3-HAM @ 5 PRIM-TRI EXIT
  THEN
  DROP 6 VOICES-N!
  T3-T @ 24.48 -
  T3-MEL @ 0 SHIM-GRAND-PIANO
  DUP 0.32 >= IF 440.0 HZ>Y ELSE QUIET THEN 1 SHIM-GRAND-PIANO
  DUP 0.48 >= IF 659.25 HZ>Y ELSE QUIET THEN 2 SHIM-GRAND-PIANO
  DUP 0.10 >= IF 220.0 HZ>Y ELSE T3-ARP1 @ THEN 3 PRIM-TRI
  DUP 0.0 >= IF -2.95 ELSE T3-PED @ THEN 4 PRIM-TRI
  T3-T @ 23.40 >= T3-T @ 24.20 < AND IF DROP 880.0 HZ>Y ELSE 1.15 >= IF 880.0 HZ>Y ELSE QUIET THEN THEN 5 PRIM-SINE ;
