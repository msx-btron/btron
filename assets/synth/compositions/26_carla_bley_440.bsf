: TRACK-EVAL ( x part -- )
  SWAP 8.0 + 2.0 * DUP T6-BEATS !
  DUP 4.0 / FLOOR >INT 0 7 CLAMP DUP T6-BARI !
  F16 4.0 * - DUP T6-BT !
  2.0 * DUP FRAC T6-SF8 ! FLOOR >INT 0 7 CLAMP T6-ST8 !

  CASE
    0 OF
      4 VOICES-N!
      T6-BEATS @ T6-P1-HI 0 PRIM-PNO  T6-BEATS @ T6-P1-MID 1 PRIM-PNO  T6-BEATS @ T6-P1-INN 2 PRIM-PNO
      T6-BT @ 3.76 < IF 55.0 HZ>Y ELSE QUIET THEN 420.0 1.8 3 PRIM-LPF
    ENDOF
    1 OF
      4 VOICES-N!
      T6-BEATS @ T6-P2-HI 0 PRIM-PNO  T6-BEATS @ T6-P2-MID 1 PRIM-PNO  T6-BEATS @ T6-P2-INN 2 PRIM-PNO
      T6-BT @ 3.76 < IF 55.0 HZ>Y ELSE QUIET THEN 420.0 1.8 3 PRIM-LPF
    ENDOF
    2 OF
      5 VOICES-N!
      T6-BEATS @ T6-P3-TOP 0 PRIM-PNO  T6-BEATS @ T6-P3-MID 1 PRIM-PNO
      T6-ST8 @ CASE 0 OF 1 ENDOF 3 OF 2 ENDOF 5 OF 1 ENDOF 7 OF 2 ENDOF 0 SWAP ENDCASE
      DUP 0 > T6-SF8 @ 0.78 < AND IF 2 = IF 110.0 ELSE 55.0 THEN HZ>Y ELSE DROP QUIET THEN 420.0 1.8 2 PRIM-LPF
      T6-ST8 @ 0 = T6-ST8 @ 3 = OR T6-ST8 @ 5 = OR T6-SF8 @ 0.55 < AND IF T6-SF8 @ T6-E8SEC * 58.0 0.12 SHIM-KICK-Y ELSE QUIET THEN 3 PRIM-SINE
      T6-ST8 @ 2 = T6-ST8 @ 6 = OR T6-SF8 @ 0.28 < AND IF 2.1 1.4 T6-SF8 @ 0.28 / * - ELSE QUIET THEN 4 PRIM-NSE
    ENDOF
    3 OF
      4 VOICES-N!
      T6-ST8 @ 0 = T6-ST8 @ 2 = OR T6-ST8 @ 3 = OR T6-ST8 @ 5 = OR T6-ST8 @ 6 = OR T6-ST8 @ 7 = OR T6-SF8 @ 0.84 < AND IF
        T6-BARI @ 3 T6-BCH HZ>Y 0 PRIM-PNO
        T6-BARI @ 2 T6-BCH HZ>Y 1 PRIM-PNO
        T6-BARI @ 1 T6-BCH HZ>Y 2 PRIM-PNO
      ELSE QUIET 0 PRIM-PNO QUIET 1 PRIM-PNO QUIET 2 PRIM-PNO THEN
      T6-BT @ 3.76 < IF
        T6-BARI @ 5 = T6-BT @ 2.0 >= AND IF 92.50 ELSE T6-BARI @ 0 T6-BCH THEN HZ>Y
      ELSE QUIET THEN 420.0 1.8 3 PRIM-LPF
    ENDOF
    4 OF
      5 VOICES-N!
      T6-ST8 @ 0 = T6-ST8 @ 2 = OR T6-ST8 @ 3 = OR T6-ST8 @ 5 = OR T6-ST8 @ 6 = OR T6-ST8 @ 7 = OR T6-SF8 @ 0.84 < AND IF
        T6-BARI @ 3 T6-BCH 2.0 * HZ>Y 0 PRIM-PNO
        T6-BARI @ 2 T6-BCH 2.0 * HZ>Y 1 PRIM-PNO
      ELSE QUIET 0 PRIM-PNO QUIET 1 PRIM-PNO THEN
      T6-BARI @ 5 = T6-BT @ 2.0 >= AND IF 92.50 ELSE T6-BARI @ 0 T6-BCH THEN
      T6-ST8 @ CASE 0 OF 1 ENDOF 2 OF 1 ENDOF 4 OF 2 ENDOF 6 OF 1 ENDOF 0 SWAP ENDCASE
      DUP 0 > T6-SF8 @ 0.78 < AND IF 2 = IF 1.5 * THEN HZ>Y ELSE 2DROP QUIET THEN 420.0 1.8 2 PRIM-LPF
      T6-ST8 @ 0 = T6-ST8 @ 3 = OR T6-ST8 @ 5 = OR T6-SF8 @ 0.55 < AND IF T6-SF8 @ T6-E8SEC * 58.0 0.12 SHIM-KICK-Y ELSE QUIET THEN 3 PRIM-SINE
      T6-ST8 @ 2 = T6-ST8 @ 6 = OR T6-SF8 @ 0.28 < AND IF 2.1 1.4 T6-SF8 @ 0.28 / * - ELSE QUIET THEN 4 PRIM-NSE
    ENDOF
    5 OF
      4 VOICES-N!
      T6-BEATS @ T6-P6-TOP 0 PRIM-PNO  T6-BEATS @ T6-P6-MID 1 PRIM-PNO
      T6-BEATS @ T6-P6-LOW 2 PRIM-PNO  T6-BEATS @ T6-P6-BAS 420.0 1.8 3 PRIM-LPF
    ENDOF
  ENDCASE ;
