VARIABLE T4-SWL  VARIABLE T4-SWR
: T4-SWARM-ALL ( t -- )
  QUIET T4-SWL !  QUIET T4-SWR !
  DUP 0.05 - DUP 0.0 >= OVER 3.8 < AND IF 3.8 / DUP 0.5 < IF 1.0 + ELSE 0.5 - -1.4 * 1.5 + THEN 0.0267 * DUP -2.25 SWAP - T4-SWL ! -2.25 + T4-SWR ! DROP EXIT THEN DROP
  DUP 7.74 - DUP 0.0 >= OVER 3.2 < AND IF 3.2 / DUP 0.5 < IF 1.0 + ELSE 0.5 - -1.4 * 1.5 + THEN 0.0233 * DUP -1.25 SWAP - T4-SWL ! -1.25 + T4-SWR ! DROP EXIT THEN DROP
  DUP 12.9 - DUP 0.0 >= OVER 3.2 < AND IF 3.2 / DUP 0.5 < IF 1.0 + ELSE 0.5 - -1.4 * 1.5 + THEN 0.025 * DUP -0.665 SWAP - T4-SWL ! -0.665 + T4-SWR ! DROP EXIT THEN DROP
  DUP 15.48 - DUP 0.0 >= OVER 3.4 < AND IF 3.4 / DUP 0.5 < IF 1.0 + ELSE 0.5 - -1.4 * 1.5 + THEN 0.03 * DUP -0.25 SWAP - T4-SWL ! -0.25 + T4-SWR ! DROP EXIT THEN DROP
  DUP 20.7 - DUP 0.0 >= OVER 3.8 < AND IF 3.8 / DUP 0.5 < IF 1.0 + ELSE 0.5 - -1.4 * 1.5 + THEN 0.005 * DUP -2.25 SWAP - T4-SWL ! -2.25 + T4-SWR ! DROP EXIT THEN DROP
  DROP ;

: T4-RVB-ALL ( t -- y )
  DUP 23.8 - DUP 0.0 >= OVER 1.95 < AND IF DUP -1.1396 * EXP DUP 1.0 SWAP - -0.85 * 2.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 23.22 - DUP 0.0 >= OVER 1.5 < AND IF DUP -1.4815 * EXP DUP 1.0 SWAP - -0.85 * 1.3333 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 20.64 - DUP 0.0 >= OVER 2.5 < AND IF DUP -0.8889 * EXP DUP 1.0 SWAP - -0.85 * 0.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 18.06 - DUP 0.0 >= OVER 2.4 < AND IF DUP -0.9259 * EXP DUP 1.0 SWAP - -0.85 * 2.5833 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 15.48 - DUP 0.0 >= OVER 2.4 < AND IF DUP -0.9259 * EXP DUP 1.0 SWAP - -0.85 * 2.3333 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 14.83 - DUP 0.0 >= OVER 1.8 < AND IF DUP -1.2346 * EXP DUP 1.0 SWAP - -0.85 * 1.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 12.9 - DUP 0.0 >= OVER 2.2 < AND IF DUP -1.0101 * EXP DUP 1.0 SWAP - -0.85 * 1.1667 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 12.25 - DUP 0.0 >= OVER 1.8 < AND IF DUP -1.2346 * EXP DUP 1.0 SWAP - -0.85 * 1.4167 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 10.32 - DUP 0.0 >= OVER 2.2 < AND IF DUP -1.0101 * EXP DUP 1.0 SWAP - -0.85 * 1.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 7.74 - DUP 0.0 >= OVER 1.4 < AND IF DUP -1.5873 * EXP DUP 1.0 SWAP - -0.85 * 2.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 5.16 - DUP 0.0 >= OVER 1.4 < AND IF DUP -1.5873 * EXP DUP 1.0 SWAP - -0.85 * 2.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 2.58 - DUP 0.0 >= OVER 1.4 < AND IF DUP -1.5873 * EXP DUP 1.0 SWAP - -0.85 * 2.75 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 1.93 - DUP 0.0 >= OVER 0.9 < AND IF DUP -2.4691 * EXP DUP 1.0 SWAP - -0.85 * 1.3333 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 1.29 - DUP 0.0 >= OVER 1.2 < AND IF DUP -1.8519 * EXP DUP 1.0 SWAP - -0.85 * 0.3333 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 0.64 - DUP 0.0 >= OVER 1.2 < AND IF DUP -1.8519 * EXP DUP 1.0 SWAP - -0.85 * 1.0 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DUP 0.05 - DUP 0.0 >= OVER 1.8 < AND IF DUP -1.2346 * EXP DUP 1.0 SWAP - -0.85 * 0.0 + SWAP 0.045 * ROT 59.69 * SIN * + -3.0 3.0 CLAMP NIP EXIT THEN DROP
  DROP QUIET ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + 16.0 / 2.58 * OVER F16 2.58 * + DUP T4-T !
  DUP T4-BASS-EV T4-BASS !
  DUP T4-LEAD-EV DUP T4-LEAD !
  T4-T @ 15.48 >= T4-T @ 20.64 < AND OVER QUIET <> AND IF 1.0 + -3.0 3.0 CLAMP ELSE DROP QUIET THEN T4-LHI !
  DUP T4-KICK-ALL T4-KICK !
  DUP T4-SNARE-ALL T4-SN !
  DUP T4-ZAP-ALL T4-ZAP !
  DUP T4-SWARM-ALL
      T4-RVB-ALL T4-RVB !

  CASE
    0 OF
      7 VOICES-N!
      T4-ZAP @ 0 SHIM-HIHAT  T4-KICK @ 25.0 1 PRIM-SAT
      T4-T @ 2.5 < IF 55.0 HZ>Y T4-T @ 2.5 / -0.0291 * + ELSE QUIET THEN 260.0 2.0 2 PRIM-LPF
      T4-SWL @ 5.0 0.015 3 PRIM-LFO  T4-SWR @ 4 PRIM-SAW  T4-SN @ 5 PRIM-NSE  T4-RVB @ 0.36 6 PRIM-RVB
    ENDOF
    1 OF
      6 VOICES-N!
      T4-KICK @ 25.0 0 PRIM-SAT  T4-BASS @ 1 SHIM-IND-BASS  T4-SN @ 2 PRIM-NSE
      T4-ZAP @ 3 SHIM-HIHAT  T4-SWL @ 5.0 0.015 4 PRIM-LFO  T4-RVB @ 0.36 5 PRIM-RVB
    ENDOF
    2 OF
      5 VOICES-N!
      T4-KICK @ 25.0 0 PRIM-SAT  T4-BASS @ 1 SHIM-IND-BASS  T4-SN @ 2 PRIM-NSE
      T4-ZAP @ 3 SHIM-HIHAT  T4-RVB @ 0.36 4 PRIM-RVB
    ENDOF
    3 OF
      6 VOICES-N!
      T4-LEAD @ 0 SHIM-CYBER-LEAD  T4-KICK @ 25.0 1 PRIM-SAT  T4-BASS @ 2 SHIM-IND-BASS
      T4-SN @ 3 PRIM-NSE  T4-SWL @ 5.0 0.015 4 PRIM-LFO  T4-RVB @ 0.36 5 PRIM-RVB
    ENDOF
    4 OF
      6 VOICES-N!
      T4-LEAD @ 0 SHIM-CYBER-LEAD  T4-KICK @ 25.0 1 PRIM-SAT  T4-BASS @ 2 SHIM-IND-BASS
      T4-SN @ 3 PRIM-NSE  T4-SWL @ 5.0 0.015 4 PRIM-LFO  T4-RVB @ 0.36 5 PRIM-RVB
    ENDOF
    5 OF
      6 VOICES-N!
      T4-LEAD @ 0 SHIM-CYBER-LEAD  T4-KICK @ 25.0 1 PRIM-SAT  T4-BASS @ 2 SHIM-IND-BASS
      T4-SN @ 3 PRIM-NSE  T4-SWL @ 5.0 0.015 4 PRIM-LFO  T4-RVB @ 0.36 5 PRIM-RVB
    ENDOF
    6 OF
      7 VOICES-N!
      T4-LHI @ 0 SHIM-CYBER-LEAD  T4-LEAD @ 1 PRIM-PLS  T4-KICK @ 25.0 2 PRIM-SAT
      T4-BASS @ 3 SHIM-IND-BASS  T4-SN @ 4 PRIM-NSE  T4-SWL @ 5.0 0.015 5 PRIM-LFO  T4-RVB @ 0.36 6 PRIM-RVB
    ENDOF
    7 OF
      7 VOICES-N!
      T4-LHI @ 0 SHIM-CYBER-LEAD  T4-LEAD @ 1 PRIM-PLS  T4-KICK @ 25.0 2 PRIM-SAT
      T4-BASS @ 3 SHIM-IND-BASS  T4-SN @ 4 PRIM-NSE  T4-ZAP @ 5 SHIM-HIHAT  T4-RVB @ 0.36 6 PRIM-RVB
    ENDOF
    8 OF
      6 VOICES-N!
      -2.95 260.0 2.0 0 PRIM-LPF  55.0 HZ>Y 20.0 1 PRIM-SAT  T4-ZAP @ 2 SHIM-HIHAT
      T4-SWL @ 5.0 0.015 3 PRIM-LFO  T4-T @ 23.0 < IF 261.63 HZ>Y ELSE QUIET THEN 4 SHIM-PULSE-BELL
      T4-RVB @ 0.36 5 PRIM-RVB
    ENDOF
    6 VOICES-N!
    T4-T @ 25.14 < IF -2.95 ELSE QUIET THEN 260.0 2.0 0 PRIM-LPF
    T4-T @ 24.64 < IF 55.0 HZ>Y ELSE QUIET THEN 20.0 1 PRIM-SAT
    T4-ZAP @ 2 SHIM-HIHAT  T4-SWL @ 5.0 0.015 3 PRIM-LFO
    T4-T @ 23.80 >= IF T4-T @ 24.45 >= IF 3.0 ELSE 1760.0 HZ>Y THEN ELSE QUIET THEN 4 PRIM-SINE
    T4-RVB @ 0.36 5 PRIM-RVB
  ENDCASE ;
