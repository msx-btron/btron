: T5-KICK-EV ( bt -- y )
  DUP 0.0000 - DUP 0.0 >= OVER 0.12 < AND IF 55.0 0.12 SHIM-KICK-Y NIP EXIT THEN DROP
  DUP 0.5794 - DUP 0.0 >= OVER 0.12 < AND IF 55.0 0.12 SHIM-KICK-Y NIP EXIT THEN DROP
  DUP 1.5450 - DUP 0.0 >= OVER 0.12 < AND IF 55.0 0.12 SHIM-KICK-Y NIP EXIT THEN DROP
      2.1244 - DUP 0.0 >= OVER 0.12 < AND IF 55.0 0.12 SHIM-KICK-Y EXIT THEN DROP QUIET ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + 16.0 / 12.36 * DUP T5-T ! 3.09 MOD T5-BT !
  CASE
    0 OF
      3 VOICES-N!
      T5-T @ T5-P1-TOP 440.0 0.60 0.48 0 PRIM-ECHO
      T5-T @ T5-P1-MID 478.0 0.54 0.36 1 PRIM-ECHO
      T5-T @ T5-P1-BAS 420.0 1.8 2 PRIM-LPF
    ENDOF
    1 OF
      3 VOICES-N!
      T5-T @ T5-P2-TOP 440.0 0.62 0.50 0 PRIM-ECHO
      T5-T @ T5-P2-MID 478.0 0.55 0.38 1 PRIM-ECHO
      T5-T @ T5-P2-BAS 420.0 1.8 2 PRIM-LPF
    ENDOF
    2 OF
      3 VOICES-N!
      T5-T @ T5-P3-TOP 440.0 0.58 0.46 0 PRIM-ECHO
      T5-T @ T5-P3-MID 478.0 0.52 0.34 1 PRIM-ECHO
      T5-T @ T5-P3-BAS 420.0 1.8 2 PRIM-LPF
    ENDOF
    3 OF
      4 VOICES-N!
      T5-T @ T5-P4-TOP 440.0 0.56 0.44 0 PRIM-ECHO
      T5-T @ T5-P4-MID 478.0 0.48 0.30 1 PRIM-ECHO
      T5-T @ T5-P4-BAS 420.0 1.8 2 PRIM-LPF
      T5-BT @ T5-KICK-EV 3 PRIM-SINE
    ENDOF
    4 OF
      4 VOICES-N!
