: T2-FROG-ONE ( dt base_f dur -- y )
  SWAP >R >R DUP 0.0 >= OVER R@ < AND IF
    DUP 0.031 / FRAC 0.74 > IF DROP R> R> 2DROP QUIET EXIT THEN
    R@ / DUP 0.75 < IF 0.75 / 0.37 * 0.88 + ELSE 0.75 - 0.25 / -0.30 * 1.25 + THEN
    R> DROP R> * HZ>Y
  ELSE DROP R> R> 2DROP QUIET THEN ;

: T2-FROG-ALL ( t -- y )
  DUP 0.15 - 125.0 0.19 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 0.40 - 155.0 0.095 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 0.95 - 112.5 0.19 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 1.20 - 139.5 0.095 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 1.90 - 143.75 0.19 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 4.28 - 131.25 0.19 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 7.04 - 118.75 0.19 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
  DUP 22.40 - 125.0 0.19 T2-FROG-ONE DUP QUIET <> IF NIP EXIT THEN DROP
      22.65 - 155.0 0.095 T2-FROG-ONE ;

: TRACK-EVAL ( x part -- )
  SWAP 8.0 + 16.0 / T2-TPART * OVER F16 T2-TPART * + DUP T2-T !
  DUP 0.612245 / T2-BT !
  DUP T2-FUKUI-EV T2-BASS !
  DUP T2-GUITAR-EV T2-GTR !
  DUP T2-FLUTE-EV T2-FLT !
  DUP T2-RHSOLO-EV T2-RHS !
  DUP T2-FROG-ALL T2-FROG !
  DUP 2.15 >= IF
    DROP
    T2-BT @ FLOOR >INT 2 IMOD 1 = T2-BT @ FRAC 0.20 < AND IF 2.25 1.3 T2-BT @ FRAC * -
    ELSE T2-BT @ FRAC 0.14 < IF 2.75 ELSE QUIET THEN THEN
  ELSE
    DUP 1.20 >= OVER 1.45 < AND IF DROP 2.75
    ELSE DUP 1.70 >= SWAP 1.95 < AND IF 2.90 ELSE QUIET THEN THEN
  THEN T2-DRM !

  CASE
    0 OF
      5 VOICES-N!
      T2-FROG @ 32.26 0.45 0 PRIM-AM
      T2-FROG @ DUP QUIET <> IF 1.2928 + ELSE DROP QUIET THEN 1 PRIM-TRI
      73.42 HZ>Y 2 SHIM-PULSE-BELL
      T2-T @ 2.2 < IF 73.42 HZ>Y T2-T @ 2.2 / -0.0291 * + ELSE T2-BASS @ THEN 180.0 1.5 3 PRIM-LPF
      T2-DRM @ 4 PRIM-SINE
    ENDOF
    1 OF
      5 VOICES-N!
      T2-BASS @ 180.0 1.5 0 PRIM-LPF
      T2-T @ 5.21 >= T2-T @ 5.75 < AND IF 523.25 HZ>Y ELSE QUIET THEN 1 PRIM-SINE
      T2-FROG @ 32.26 0.45 2 PRIM-AM
      T2-BT @ 0.5 * FRAC DUP 0.12 < IF 1.22 * 65.0 0.16 SHIM-KICK-Y ELSE DROP QUIET THEN 3 PRIM-SINE
      T2-DRM @ 4 PRIM-SINE
    ENDOF
    2 OF
      6 VOICES-N!
      T2-GTR @ 0 PRIM-TRI  T2-FLT @ 1 PRIM-TRI  T2-BASS @ 2 PRIM-TRI
      T2-T @ 6.12 >= T2-T @ 6.60 < AND IF 493.88 HZ>Y 880.0 HZ>Y
      ELSE T2-T @ 7.04 >= T2-T @ 7.35 < AND IF 466.16 HZ>Y 739.99 HZ>Y
      ELSE T2-T @ 8.57 >= T2-T @ 9.00 < AND IF 440.0 HZ>Y 659.25 HZ>Y
      ELSE QUIET QUIET THEN THEN THEN 4 PRIM-SINE 3 PRIM-SINE
      T2-DRM @ 5 PRIM-SINE
    ENDOF
    3 OF
      6 VOICES-N!
      T2-GTR @ 0 PRIM-TRI  T2-FLT @ 1 PRIM-TRI  T2-BASS @ 2 PRIM-TRI
      T2-T @ 9.80 >= T2-T @ 10.40 < AND IF 440.0 HZ>Y 659.25 HZ>Y
      ELSE T2-T @ 11.02 >= T2-T @ 11.55 < AND IF 493.88 HZ>Y 880.0 HZ>Y
      ELSE T2-T @ 11.63 >= T2-T @ 12.15 < AND IF 466.16 HZ>Y 739.99 HZ>Y
      ELSE QUIET QUIET THEN THEN THEN 4 PRIM-SINE 3 PRIM-SINE
      T2-DRM @ 5 PRIM-SINE
    ENDOF
    4 OF
      6 VOICES-N!
      T2-GTR @ 0 PRIM-TRI  T2-FLT @ 1 PRIM-TRI  T2-BASS @ 2 PRIM-TRI
      T2-RHS @ 3 PRIM-SINE  98.00 HZ>Y 4 SHIM-PULSE-BELL
      T2-T @ 14.20 >= T2-T @ 14.68 < AND T2-T @ 14.20 - 10.0 * FRAC 0.72 < AND IF 2.45 ELSE T2-DRM @ THEN 5 PRIM-SINE
    ENDOF
    5 OF
      5 VOICES-N!
      T2-RHS @ 0 PRIM-SINE  T2-GTR @ 1 PRIM-TRI  T2-FLT @ 2 PRIM-TRI  T2-BASS @ 3 PRIM-TRI  T2-DRM @ 4 PRIM-SINE
    ENDOF
    6 OF
      6 VOICES-N!
      T2-GTR @ 0 PRIM-TRI  T2-FLT @ 1 PRIM-TRI
      T2-T @ 18.98 >= T2-T @ 19.43 < AND IF 1760.0 HZ>Y ELSE QUIET THEN 2 PRIM-SINE
      T2-BASS @ 3 PRIM-TRI
      T2-T @ 19.60 >= T2-T @ 19.76 < AND T2-T @ 20.82 >= T2-T @ 20.98 < AND OR IF T2-T @ FRAC 0.4 * 65.0 0.16 SHIM-KICK-Y ELSE QUIET THEN 4 PRIM-SINE
      T2-DRM @ 5 PRIM-SINE
    ENDOF
    6 VOICES-N!
    T2-T @ 22.05 >= IF 523.25 HZ>Y ELSE QUIET THEN 0 PRIM-SINE
    T2-T @ 22.05 >= IF 659.25 HZ>Y ELSE QUIET THEN 1 PRIM-SINE
    T2-BASS @ 2 PRIM-TRI
    T2-FROG @ 3 PRIM-SAW
    73.42 HZ>Y 4 SHIM-PULSE-BELL
    T2-T @ 22.8 < IF T2-DRM @ ELSE QUIET THEN 5 PRIM-SINE
  ENDCASE ;
