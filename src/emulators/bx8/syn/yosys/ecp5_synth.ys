# Yosys Open-Source Synthesis Script for MSX turbo R on Lattice ECP5
# Target board: Muse Lab iCESugar-Pro, device LFE5U-25F-6BG256C.
# Reads generated Verilog from BSC. This script is not a bitstream,
# and it does not program the board.

# Read ECP5 blackbox cell library
read_verilog -lib +/ecp5/cells_bb.v

# Read BSC Verilog library primitives
read_verilog -sv /opt/homebrew/Cellar/bsc/2026.07.1_1/libexec/lib/Verilog/FIFO2.v
read_verilog -sv /opt/homebrew/Cellar/bsc/2026.07.1_1/libexec/lib/Verilog/FIFO1.v
read_verilog -sv /opt/homebrew/Cellar/bsc/2026.07.1_1/libexec/lib/Verilog/SizedFIFO.v

# Read Verilog sources generated by BSC
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkMSXClocks.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkMemoryArbiter.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkTopMSXTurboR.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkCPUCore.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkR800Multiplier.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkT9769C.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkSlotManager.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkMapper.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkRaster.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkBlitter.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkV9958.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkPSG.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkSCC.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkPCM.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkPPI.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/sim/verilator/mkKeyboard.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/syn/boards/msx_soc_shell.v
read_verilog -sv /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/syn/boards/icesugar_pro/TopIceSugarPro.v

# Hierarchy elaboration
hierarchy -check -top TopIceSugarPro

# High-level synthesis optimizations
proc
opt
fsm
opt
memory
opt

# ECP5 gate mapping
synth_ecp5 -top TopIceSugarPro -json /Users/tonpa/depot/bitedits/btron/src/emulators/bx8/syn/yosys/msx_turbor_ecp5.json

# Resource utilization report
stat
